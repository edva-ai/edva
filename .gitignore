# ─── Credentials & secrets ───────────────────────────────────────────────
.env
**/.env.bak*
credentials/
secrets/
# Never commit Firebase admin SDK / service-account keys
*service-account*.json
*-adminsdk-*.json
*service_account*.json
# Project-scope MCP configs are per host (they can name machine paths and
# accounts). The ops-light and ops-haiku tiers ship placeholder-only configs
# (${VAR} expanded from the environment process-manager loads from .env); the
# ops tier's own lives at agent/ops-agent/.mcp.json, copied from
# examples/mcp/ops-agent.mcp.example.json.
.mcp.json
!agent/ops-light-agent/.mcp.json
!agent/ops-haiku-agent/.mcp.json

# ─── Per-installation overlay ────────────────────────────────────────────
# See docs/architecture-public-private.md.
#
# agent/local/ holds this installation's identity (instance.json), its own
# agent rules (shared.md, chat.md, ops.md, jobs/<job>.md, prompts/), its
# values (config/<name>.json) and its registry entries (tasks.json, ...).
# The kernel reads it through lib/instance.cjs, lib/registry.cjs and the
# supervisors; it never belongs in the public tree. `edva overlay add`
# links it in from a private repo.
agent/local/
# Legacy root-level overlay dir (pre agent/local/).
/local/
# `_ext/` dirs are the hook and drop points next to the kernel code that loads
# them (lib/_ext/, agent/supervisor/_ext/, agent/ops-agent/jobs/_ext/, ...).
# Each ships only its `.gitkeep`, which documents that point's contract;
# everything placed in them is the installation's own.
**/_ext/*
!**/_ext/.gitkeep
# Agent-authored capability modules approved on this host (agent/ext/README.md)
# and their staging area.
agent/ext/*
!agent/ext/README.md
# The operator's own browsing skills (the kernel ships the runner, not skills).
browsing-skills/skills/
# Host registry for `edva whereami` (hostnames + hardware UUIDs);
# template: examples/hosts.example.json.
system/hosts.json
# Personal scratch outside the well-known dirs.
*.local.md
*.local.json

# ─── Runtime state ───────────────────────────────────────────────────────
# Everything under data/ is mutated by running processes (DBs, ndjson logs,
# cursors, state files, snapshots). Tracking any of it means a `git reset
# --hard` or checkout can roll live state back to an old commit, so the whole
# directory stays on the host. Seed/config examples live under examples/.
data/
# Per-process logs.
logs/
agent/logs/
# Per-agent supervisor state (turn counts, rotation markers, session ids) —
# rewritten every turn; code handles its absence.
agent/supervisor/state/
# Job-local logs and agent scratch.
agent/ops-agent/jobs/*.log
agent/ops-light-agent/.ideation-*.json
# WhatsApp channel auth state.
agent/whatsapp-channel/wa-auth/

# ─── Build / tool artifacts ──────────────────────────────────────────────
node_modules/
__pycache__/
.DS_Store
# Xcode / Ruby artifacts from the companion apps
apps/**/SourcePackages/
apps/**/vendor/
apps/**/.bundle/
apps/**/fastlane/report.xml
apps/**/build/
apps/telemetry/.vercel/
# Claude Code local state (per-workspace lock files + user-local settings)
.claude/
# Stray temp/backup files left by jobs and editors.
/tmp/
*.bak
*.bak.*
*.json.tmp
