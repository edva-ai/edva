#!/usr/bin/env node
// app-perf — how responsive the Edva app has been on the user's devices.
//
// Reads app_perf_events (data/migrations/20261024_app_perf_events.sql),
// written by client/Edva/Responsiveness.swift:
//   hang        main thread blocked >= 250 ms (in-app watchdog), with the screen
//   metrics     Apple's daily MetricKit report (hang-time histogram, launch,
//               scroll hitch ratio on iOS)
//   diagnostic  MetricKit hang/crash diagnostics with call stacks
//
// Read-only. Usage:
//   app-perf [--days N]            summary per platform and build (default 7)
//   app-perf hangs [--days N]      the individual hangs, newest first
//   app-perf diagnostics [--days N] [--full]   MetricKit diagnostics

import path from "node:path";
import { createRequire } from "node:module";
import fs from "node:fs";
import { installRoot } from "../lib/root.cjs";

const ROOT = installRoot();
for (const l of (() => { try { return fs.readFileSync(path.join(ROOT, ".env"), "utf8").split("\n"); } catch { return []; } })()) {
  const m = l.match(/^([A-Z_]+)=(.*)$/); if (m && !process.env[m[1]]) process.env[m[1]] = m[2];
}
const BASE = process.env.SUPABASE_URL || createRequire(import.meta.url)("../lib/instance.cjs").supabaseUrl();
const K = process.env.SUPABASE_SERVICE_ROLE_KEY;
if (!K) { console.error("app-perf: no SUPABASE_SERVICE_ROLE_KEY"); process.exit(1); }
const H = { apikey: K, Authorization: "Bearer " + K };

const args = process.argv.slice(2);
const cmd = args[0] && !args[0].startsWith("--") ? args[0] : "summary";
const dIdx = args.indexOf("--days");
const days = dIdx >= 0 ? Number(args[dIdx + 1]) || 7 : 7;
const full = args.includes("--full");
const since = new Date(Date.now() - days * 86400e3).toISOString();

async function rows(kind, select) {
  const url = `${BASE}/rest/v1/app_perf_events?kind=eq.${kind}&occurred_at=gte.${encodeURIComponent(since)}` +
    `&select=${select}&order=occurred_at.desc&limit=5000`;
  const r = await fetch(url, { headers: H });
  if (!r.ok) { console.error(`app-perf: ${r.status} ${await r.text()}`); process.exit(1); }
  return r.json();
}

const tz = createRequire(import.meta.url)("../lib/instance.cjs").instanceValue("tz");
const homeFmt = (iso) => new Date(iso).toLocaleString("en-US", { timeZone: tz, month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
const pct = (xs, p) => { if (!xs.length) return 0; const s = [...xs].sort((a, b) => a - b); return s[Math.min(s.length - 1, Math.floor(p * s.length))]; };

if (cmd === "hangs") {
  const hs = await rows("hang", "occurred_at,platform,build,duration_ms,context");
  if (!hs.length) { console.log(`No hangs in the last ${days} day(s).`); process.exit(0); }
  for (const h of hs) console.log(`${homeFmt(h.occurred_at).padEnd(18)} ${h.platform.padEnd(7)} build ${String(h.build).padEnd(5)} ${String(h.duration_ms).padStart(6)} ms  ${h.context ?? ""}`);
  process.exit(0);
}

if (cmd === "diagnostics") {
  const ds = await rows("diagnostic", "occurred_at,platform,build,payload");
  if (!ds.length) { console.log(`No MetricKit diagnostics in the last ${days} day(s).`); process.exit(0); }
  for (const d of ds) {
    const p = d.payload ?? {};
    const hangs = p.hangDiagnostics ?? [];
    const crashes = p.crashDiagnostics ?? [];
    console.log(`${homeFmt(d.occurred_at)} ${d.platform} build ${d.build}: ${hangs.length} hang(s), ${crashes.length} crash(es)`);
    for (const h of hangs) {
      console.log(`  hang ${h.diagnosticMetaData?.hangDuration ?? "?"}`);
      if (full) console.log(JSON.stringify(h.callStackTree, null, 1).slice(0, 20000));
    }
  }
  process.exit(0);
}

// summary
const hs = await rows("hang", "occurred_at,platform,build,duration_ms,context");
const ms = await rows("metrics", "occurred_at,platform,build,payload");
console.log(`Edva app responsiveness, last ${days} day(s)\n`);
const groups = new Map();
for (const h of hs) {
  const k = `${h.platform} build ${h.build}`;
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k).push(h);
}
if (!groups.size) console.log("Hangs (>=250 ms): none recorded.");
for (const [k, list] of groups) {
  const d = list.map((h) => h.duration_ms);
  const byCtx = {};
  for (const h of list) byCtx[h.context ?? "?"] = (byCtx[h.context ?? "?"] ?? 0) + 1;
  const ctx = Object.entries(byCtx).sort((a, b) => b[1] - a[1]).map(([c, n]) => `${c} ${n}`).join(", ");
  console.log(`${k}: ${list.length} hang(s), median ${pct(d, 0.5)} ms, p90 ${pct(d, 0.9)} ms, worst ${Math.max(...d)} ms — ${ctx}`);
}
console.log("");
if (!ms.length) console.log("MetricKit: no daily reports yet (Apple delivers about once a day per device).");
for (const m of ms.slice(0, 10)) {
  const p = m.payload ?? {};
  const hitch = p.animationMetrics?.scrollHitchTimeRatio;
  const launch = p.applicationLaunchMetrics?.histogrammedTimeToFirstDrawKey?.histogramValue;
  const hangHist = p.applicationResponsivenessMetrics?.histogrammedAppHangTime?.histogramValue;
  const hangCount = hangHist ? Object.values(hangHist).reduce((a, b) => a + (b.bucketCount ?? 0), 0) : 0;
  const launchCount = launch ? Object.values(launch).reduce((a, b) => a + (b.bucketCount ?? 0), 0) : 0;
  console.log(`MetricKit ${homeFmt(m.occurred_at)} ${m.platform} build ${m.build}: ` +
    `${hitch ? `scroll hitch ${hitch}, ` : ""}${hangCount} hang(s) reported, ${launchCount} launch(es)`);
}
