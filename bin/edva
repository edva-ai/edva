  console.log('  resume                       unpause');
  console.log('  feedback <ping-id> <reaction>  record reaction: helpful | skip | snooze | more | 👍 | 👎');
  console.log('    (use ping-id "last" to reference the most recent ping)');
  console.log('  runs [--tail N]              tail hum-runs.jsonl (default 10)');
  console.log('  review [--since Nd]          what was surfaced / reacted to (default 7d)');
  console.log('  test                         fire a one-shot tick via webhook');
  console.log('  tune                         show current config + feedback bias');
  console.log('  question                     show current pending question (or null)');
  console.log('  learn <id> <answer>          record a manual answer for the pending question');
  console.log('  learnings [--tail N]         tail hum-learnings.jsonl (default 10)');
  console.log('  situation [--json]           composite snapshot: where/env/time/now/next/working-on');
  console.log('  sense [status|once|sensors|tail|emit ...]   situational trigger engine (default: status)');
  console.log('  insight [--since Nd]         aggregate last N days of tick traces into metrics (default 7d)');
  console.log('  reactions [--since Nd] [--json]  per-lane reaction-rate (surfaced/reacted/positive) from hum-feedback.jsonl');
  console.log('  signal [--since Nd] [--lane <name>] [--json]  weighted signal dashboard (love=2x, up=1x; canonical: hum-improvement-loop.md)');
  console.log('  intervention list | record | measure  hum-improvement-loop intervention attribution ledger');
  console.log('  lane status | enable <name> [reason] | disable <name> [reason]  manual lever for auto-quiesce (2 consecutive expired-unanswered lane_diagnosis questions pauses a lane)');
  console.log('  audit [--window 24h|7d] [--json]  drift check: outcome.sent count vs hum-feedback entries\n');
  console.log(c.dim('State files:'));
  console.log(c.dim(`  ${HUM_STATE}`));
  console.log(c.dim(`  ${HUM_SEEN}`));
  console.log(c.dim(`  ${HUM_FEEDBK}`));
  console.log(c.dim(`  ${HUM_RUNS}`));
}

function cmdHumStatus(args) {
  const s = loadHumState();
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(s, null, 2)); return; }
  console.log(c.bold('Hum Status') + '\n');
  if (s.pause && s.pause.until && new Date(s.pause.until) > new Date()) {
    console.log(`  ${c.yellow('PAUSED')} until ${new Date(s.pause.until).toLocaleString()}`);
    if (s.pause.reason) console.log(`  reason:  ${s.pause.reason}`);
  } else {
    console.log(`  state:   ${c.green('active')}`);
  }
  const minIntMin = enforcedPingCaps().minIntervalMin; // the code-enforced budget (lib/ping-budget.mjs)
  if (s.last_ping_at) {
    const lastPingMs = Date.now() - new Date(s.last_ping_at).getTime();
    const minMs = minIntMin * 60 * 1000;
    if (lastPingMs < minMs) {
      const m = Math.round((minMs - lastPingMs) / 60000);
      console.log(`  min-interval: ${c.yellow(`${m}m remaining`)} (${minIntMin}m)`);
    } else {
      console.log(`  min-interval: ${c.green('clear')} (${minIntMin}m)`);
    }
  }
  const today = s.today || {};
  const cap = enforcedPingCaps().maxPerDay; // the code-enforced budget (lib/ping-budget.mjs)
  const capColor = (today.pings || 0) >= cap ? c.red : c.green;
  const runs = today.runs || 0;
  const pings = today.pings || 0;
  const questions = today.questions || 0;
  const logOnly = today.log_only || 0;
  console.log(`  today:    ${runs} ticks, ${capColor(`${pings}/${cap} pings`)}, ${questions} questions, ${logOnly} log-only`);
  console.log(`  last run: ${formatHumTime(s.last_run_at)}`);
  console.log(`  last ping: ${formatHumTime(s.last_ping_at)}`);

  // Pending question, if any
  try {
    const raw = fs.readFileSync(HUM_PENDING_Q, 'utf8').trim();
    if (raw && raw !== 'null') {
      const q = JSON.parse(raw);
      const exp = new Date(q.expires_at);
      const remMin = Math.round((exp.getTime() - Date.now()) / 60000);
      const status = remMin > 0 ? c.yellow(`${remMin}m left`) : c.red('EXPIRED');
      console.log(`  pending question: ${c.bold(q.subject)} [${status}]`);
    }
  } catch {}

  // Last outbound Edva message stamp
  try {
    const stamp = JSON.parse(fs.readFileSync(path.join(TOOLS, 'data/last-edva-message-at.json'), 'utf8'));
    if (stamp.ts) console.log(`  last outbound msg: ${formatHumTime(stamp.ts)}`);
  } catch {}
}

function cmdHumPause(args) {
  const durStr = args[0];
  if (!durStr) die('hum pause: duration required (e.g. "2h", "today", "until-morning", "weekend")');
  const until = parseHumDuration(durStr);
  if (!until) die(`hum pause: could not parse duration "${durStr}"`);
  const s = loadHumState();
  s.pause = { until, reason: args.slice(1).join(' ') || null, set_at: new Date().toISOString() };
  saveHumState(s);
  console.log(`${c.yellow('Paused')} until ${new Date(until).toLocaleString()}`);
}

function cmdHumResume(args) {
  const s = loadHumState();
  if (!s.pause) { console.log(c.dim('hum was not paused')); return; }
  s.pause = null;
  saveHumState(s);
  console.log(c.green('Resumed'));
}

// Advisory lock around hum-feedback.jsonl. Must match the lockfile path used
// by bin/hum-ping so reaction updates and ping appends serialize — a
// naïve read-modify-write here would otherwise silently clobber a concurrent
// append from a freshly-sent hum ping.
const HUM_FEEDBK_LOCK = path.join(TOOLS, 'data/.hum-feedback.lock');
function humFeedbackLockAcquire(timeoutMs = 5000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    try { fs.mkdirSync(HUM_FEEDBK_LOCK); return true; }
    catch (e) {
      if (e.code !== 'EEXIST') throw e;
      try {
        const age = Date.now() - fs.statSync(HUM_FEEDBK_LOCK).mtimeMs;
        if (age > 30_000) { try { fs.rmdirSync(HUM_FEEDBK_LOCK); } catch {} continue; }
      } catch {}
      const until = Date.now() + 20 + Math.floor(Math.random() * 30);
      while (Date.now() < until) { /* spin */ }
    }
  }
  return false;
}
function humFeedbackLockRelease() { try { fs.rmdirSync(HUM_FEEDBK_LOCK); } catch {} }

// Maps a normalized tapback token (see HUM_REACTION_ALIASES) to the
// disposition/reaction_token vocabulary shared by suggestion-history.mjs and
// hum-responses.mjs, so a one-word reaction scores the same as its
// conversational equivalent ("more"/heart = love-strength, "helpful"/thumbs-up
// = up-strength — matches the split suggestion-classify already uses).
function humReactionToDisposition(norm) {
  switch (norm) {
    case 'helpful': return { disposition: 'positive', reaction_token: 'up' };
    case 'more':    return { disposition: 'positive', reaction_token: 'love' };
    case 'skip':    return { disposition: 'negative', reaction_token: 'down' };
    case 'snooze':  return { disposition: 'snoozed', reaction_token: 'snooze' };
    default:        return { disposition: null, reaction_token: null };
  }
}

async function cmdHumFeedback(args) {
  let pingId = args[0];
  const reaction = args[1];
  if (!pingId || !reaction) die('hum feedback <ping-id|last> <reaction>');
  const norm = HUM_REACTION_ALIASES[reaction.toLowerCase()] || reaction;

  if (!humFeedbackLockAcquire()) {
    console.error(c.yellow('warn') + ': could not acquire hum-feedback lock after 5s; proceeding anyway');
  }

  let raw;
  try { raw = fs.readFileSync(HUM_FEEDBK, 'utf8'); }
  catch (e) {
    humFeedbackLockRelease();
    if (e.code === 'ENOENT') die('no hum feedback log yet');
    throw e;
  }
  const lines = raw.split('\n');

  if (pingId === 'last') {
    for (let i = lines.length - 1; i >= 0; i--) {
      if (!lines[i].trim()) continue;
      try {
        const r = JSON.parse(lines[i]);
        if (r.ping_id) { pingId = r.ping_id; break; }
      } catch {}
    }
    if (pingId === 'last') die('no ping-id found in feedback log');
  }

  let found = false;
  let matchedEntry = null;
  const out = lines.map(line => {
    if (!line.trim()) return line;
    try {
      const r = JSON.parse(line);
      if (r.ping_id === pingId) {
        r.reaction = norm;
        r.reaction_at = new Date().toISOString();
        found = true;
        matchedEntry = r;
        return JSON.stringify(r);
      }
      return line;
    } catch { return line; }
  });
  if (!found) {
    humFeedbackLockRelease();
    die(`no ping found with id "${pingId}"`);
  }

  const tmp = HUM_FEEDBK + '.tmp.' + process.pid;
  try {
    fs.writeFileSync(tmp, out.join('\n'));
    fs.renameSync(tmp, HUM_FEEDBK);
  } finally {
    humFeedbackLockRelease();
  }
  console.log(`${c.green('Recorded')} reaction "${norm}" for ${pingId}`);

  // Dual-log write: a tapback/reaction-word reply ("helpful"/"skip"/"snooze"/
  // "more") used to only flip `reaction` on the matching hum-feedback.jsonl
  // row above. That left hum-responses.jsonl (overnight consolidation + same-
  // day re-ask suppression) and suggestion-history.jsonl (the signal tracker
  // hum-improvement-loop scores read) blind to every reaction-word reply —
  // only free-text replies through suggestion-classify wrote those. Mirror
  // that path here so both mechanisms see the same reply regardless of shape.
  // (Fixed after hum's "ideas" lane reported 11 pings/0
  // reactions when at least 4 had actually gotten a "helpful".)
  const headline = (matchedEntry?.findings || [])[0] || null;
  const subjectKey = headline?.subject_key || headline?.dedup_key || null;
  const display = headline?.subject_display || headline?.signal?.slice(0, 80) || null;
  const { disposition, reaction_token } = humReactionToDisposition(norm);
  try {
    const { appendResponse } = await import(path.join(TOOLS, 'lib/hum-responses.mjs'));
    appendResponse({
      ping_id: pingId,
      lane: matchedEntry?.lane || null,
      subject: display,
      subject_key: subjectKey,
      ping_text: display,
      reply_text: reaction,
      disposition,
      source: 'tapback_edva_cli',
    });
  } catch (e) {
    console.error(c.dim(`  (hum-responses capture warn: ${e.message})`));
  }
  if (subjectKey && disposition) {
    try {
      const { appendReaction } = await import(path.join(TOOLS, 'lib/suggestion-history.mjs'));
      appendReaction({
        subject_key: subjectKey,
        disposition,
        reaction_token,
        reason: null,
        reason_detail: null,
        source: 'phone_tapback',
        evidence: reaction,
        message_id: null,
      });
    } catch (e) {
      console.error(c.dim(`  (suggestion-history capture warn: ${e.message})`));
    }
  }

  // Reinforcement loop: if the ping originated from an idea, append the
  // reaction to hum-ideas.jsonl so the next ideation run can read it and
  // bias generation. See system/hum-ideas-reservoir.md.
  try {
    const ideasFile = path.join(TOOLS, 'data/hum-ideas.jsonl');
    const ideaRaw = fs.readFileSync(ideasFile, 'utf8');
    const ideaLines = ideaRaw.split('\n').filter(Boolean);
    let matchedIdeaId = null;
    for (const line of ideaLines) {
      try {
        const r = JSON.parse(line);
        if (r.ping_id === pingId && r.id) { matchedIdeaId = r.id; break; }
      } catch {}
    }
    if (matchedIdeaId) {
      const reactionRecord = {
        id: matchedIdeaId,
        reaction: norm,
        reacted_at: new Date().toISOString(),
        ping_id: pingId,
      };
      fs.appendFileSync(ideasFile, JSON.stringify(reactionRecord) + '\n');
      console.log(c.dim(`  → linked to idea ${matchedIdeaId}`));
    }
  } catch (e) {
    if (e.code !== 'ENOENT') console.error(c.dim(`  (idea-link warn: ${e.message})`));
  }
}

function cmdHumRuns(args) {
  const tailStr = getFlag(args, '--tail', '10');
  const tail = Math.max(1, parseInt(tailStr, 10) || 10);
  let raw;
  try { raw = fs.readFileSync(HUM_RUNS, 'utf8'); }
  catch (e) { if (e.code === 'ENOENT') { console.log(c.dim('(no runs yet)')); return; } throw e; }
  const lines = raw.split('\n').filter(Boolean);
  const recent = lines.slice(-tail);
  if (!recent.length) { console.log(c.dim('(no runs yet)')); return; }
  const rows = recent.map(line => {
    try {
      const r = JSON.parse(line);
      const modeColor = r.mode === 'ping' ? c.green : (r.mode === 'error' ? c.red : c.dim);
      return {
        ts: String(r.ts || '').slice(0, 19),
        mode: modeColor(r.mode || '?'),
        // Current trace (hum.md Step 4) nests the ranker verdict under
        // `sonnet.*`; the flat top_score/decision/deferral_reason fields are
        // the pre-2026-07 shape, kept as a fallback for old rows.
        lane: (r.sonnet && r.sonnet.based_on_topic) || r.lane_rotated || '—',
        top: (() => { const s = r.sonnet && typeof r.sonnet.score === 'number' ? r.sonnet.score : r.top_score; return typeof s === 'number' ? s.toFixed(2) : '—'; })(),
        decision: (r.sonnet && r.sonnet.decision) || r.decision || '—',
        reason: (r.sonnet && r.sonnet.silent_root_cause) || (r.outcome && r.outcome.downgrade_reason) || r.deferral_reason || c.dim('—'),
      };
    } catch { return { ts: c.dim('(unparsable)'), mode: '', lane: '', top: '', decision: '', reason: '' }; }
  });
  console.log(table(rows, ['ts', 'mode', 'lane', 'top', 'decision', 'reason']));
}

function cmdHumReview(args) {
  const sinceStr = getFlag(args, '--since', '7d');
  const m = String(sinceStr).match(/^(\d+)([hd])$/);
  const since = new Date();
  if (m) {
    const n = parseInt(m[1], 10);
    if (m[2] === 'h') since.setHours(since.getHours() - n);
    else since.setDate(since.getDate() - n);
  } else { since.setDate(since.getDate() - 7); }
  let raw;
  try { raw = fs.readFileSync(HUM_FEEDBK, 'utf8'); }
  catch (e) { if (e.code === 'ENOENT') { console.log(c.dim('(no feedback log yet)')); return; } throw e; }
  const lines = raw.split('\n').filter(Boolean);
  const entries = lines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean)
                       .filter(e => e.sent_at && new Date(e.sent_at) >= since);
  console.log(c.bold(`Hum review — since ${since.toLocaleString()}`) + '\n');
  console.log(`  total pings: ${entries.length}`);
  const byLane = {}, byReact = { helpful: 0, skip: 0, snooze: 0, more: 0, silence: 0, none: 0 };
  for (const e of entries) {
    byLane[e.lane] = (byLane[e.lane] || 0) + 1;
    const r = e.reaction || (e.reaction_at ? 'silence' : 'none');
    byReact[r] = (byReact[r] || 0) + 1;
  }
  console.log('\n  ' + c.bold('By reaction:'));
  for (const [k, v] of Object.entries(byReact)) console.log(`    ${k}: ${v}`);
  console.log('\n  ' + c.bold('By lane:'));
  for (const [k, v] of Object.entries(byLane)) console.log(`    ${k}: ${v}`);
}

function cmdHumTest(args) {
  const lane = getFlag(args, '--lane', null);
  const payload = lane ? JSON.stringify({ job: 'hum', force_lane: lane }) : JSON.stringify({ job: 'hum' });
  console.log(c.dim(`Dispatching hum to http://localhost:9092 (bypasses jitter)...`));
  const res = shSafe(`curl -sf --max-time 5 -X POST http://localhost:9092 -H "Content-Type: application/json" -d '${payload}'`);
  if (res === null) die('dispatch failed — is the ops supervisor running? Check: edva status');
  console.log(c.green('Dispatched.') + ' Tail progress: ' + c.dim('edva hum runs --tail 5'));
}

// Passthrough to the situational trigger engine — `edva hum sense status`
// is the same thing as `hum-sense status`, and lives here so the whole hum
// subsystem is discoverable from one place.
function cmdHumSense(args) {
  const { spawnSync } = require('child_process');
  const r = spawnSync(path.join(TOOLS, 'bin/hum-sense'), args.length ? args : ['status'], { stdio: 'inherit' });
  process.exit(r.status ?? 0);
}

function cmdHumTune(args) {
  const s = loadHumState();
  console.log(c.bold('Hum tuning') + '\n');
  console.log(`  min_ping_interval_minutes: ${enforcedPingCaps().minIntervalMin}`);
  console.log(`  max_pings_per_day: ${enforcedPingCaps().maxPerDay}`);
  console.log(`  schema_version: ${s.schema_version ?? 1}`);
  console.log(c.dim('\nThe ping budget is enforced in code (lib/ping-budget.mjs; env HUM_MAX_PINGS_PER_DAY /'));
  console.log(c.dim('HUM_MIN_PING_INTERVAL_MIN); the two fields in ' + HUM_STATE + ' are ignored.'));
  console.log(c.dim('Weekly hum-review proposes tuning based on reactions + answer rates.'));
}

// --- cost ---
function cmdCost(args) {
  const data = shSafe('curl -sf --max-time 3 http://127.0.0.1:9093/cost');
  if (!data) { die('supervisor not reachable on :9093. Is the ops-supervisor running?'); return; }
  const j = JSON.parse(data);
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(j, null, 2)); return; }
  console.log(c.bold('Ops Agent Cost') + '\n');
  console.log(`  today:   $${j.todayUsd?.toFixed(4) || '0.0000'}`);
  console.log(`  week:    $${j.weekUsd?.toFixed(4) || '0.0000'}`);
  console.log(`  total:   $${j.totalUsd?.toFixed(4) || '0.0000'}`);
  if (j.perModel && Object.keys(j.perModel).length) {
    console.log(`\n  ${c.bold('Per model:')}`);
    for (const [m, cost] of Object.entries(j.perModel)) {
      console.log(`    ${m}: $${cost.toFixed(4)}`);
    }
  }
  console.log(`  entries: ${j.entries || 0}`);
}

const HUM_PENDING_Q = installTools("data/hum-pending-question.json");
const HUM_LEARNINGS = installTools("data/hum-learnings.jsonl");
const HUM_ANSWER_BIN = installTools("bin/hum-answer");

function cmdHumQuestion(args) {
  try {
    const raw = require('fs').readFileSync(HUM_PENDING_Q, 'utf8').trim();
    if (!raw || raw === 'null') { console.log(c.dim('(no pending question)')); return; }
    const q = JSON.parse(raw);
    if (hasFlag(args, '--json')) { console.log(JSON.stringify(q, null, 2)); return; }
    console.log(c.bold('Pending Question') + '\n');
    console.log(`  id:           ${q.id}`);
    console.log(`  asked_at:     ${q.asked_at}`);
    console.log(`  expires_at:   ${q.expires_at}`);
    console.log(`  subject:      ${q.subject}`);
    console.log(`  memory_hook:  ${q.memory_hook}`);
    console.log(`\n  ${q.question}`);
  } catch (e) {
    if (e.code === 'ENOENT') { console.log(c.dim('(no pending question)')); return; }
    throw e;
  }
}

function cmdHumLearn(args) {
  const [id, ...rest] = args;
  const answer = rest.join(' ').trim();
  if (!id || !answer) die('hum learn <id> <answer>');
  const { spawnSync } = require('child_process');
  const r = spawnSync(HUM_ANSWER_BIN, [id, answer], { encoding: 'utf8' });
  if (r.stdout) process.stdout.write(r.stdout);
  if (r.stderr) process.stderr.write(r.stderr);
  process.exit(r.status ?? 0);
}

function cmdHumLearnings(args) {
  let n = 10;
  for (let i = 0; i < args.length; i++) if (args[i] === '--tail' && args[i + 1]) n = parseInt(args[++i], 10);
  try {
    const lines = require('fs').readFileSync(HUM_LEARNINGS, 'utf8').trim().split('\n').filter(Boolean);
    const tail = lines.slice(-n);
    if (hasFlag(args, '--json')) { console.log(tail.join('\n')); return; }
    console.log(c.bold(`Last ${tail.length} hum learnings`) + '\n');
    for (const line of tail) {
      const r = JSON.parse(line);
      const d = new Date(r.answered_at).toLocaleString();
      console.log(`${c.dim(d)}  ${c.bold(r.subject)}  [${r.memory_hook}]`);
      console.log(`  Q: ${r.question.slice(0, 140)}`);
      console.log(`  A: ${r.answer.slice(0, 200)}\n`);
    }
  } catch (e) {
    if (e.code === 'ENOENT') { console.log(c.dim('(no learnings yet)')); return; }
    throw e;
  }
}

// Composite situation snapshot for hum. Gathers where/environment/time/
// activity/next/working-on signals. Cached 2 min in TMPDIR so multiple
// callers within a tick share one computation.
const SITUATION_CACHE = path.join(process.env.TMPDIR || '/tmp', 'edva-situation.json');

function readJsonSafe(p) {
  try { return JSON.parse(require('fs').readFileSync(p, 'utf8')); } catch { return null; }
}

function buildSituation() {
  const fs = require('fs');
  const tz = readJsonSafe(path.join(TOOLS, 'data/user-timezone.json'))?.timezone || instance().tz;
  const cursor = readJsonSafe(path.join(TOOLS, 'data/phone-channel-cursor.json'));
  const lastInboundMs = cursor?.lastSeenAt ? Date.now() - new Date(cursor.lastSeenAt).getTime() : null;
  const inboundMinAgo = lastInboundMs !== null ? Math.round(lastInboundMs / 60000) : null;
  const lastOut = readJsonSafe(path.join(TOOLS, 'data/last-edva-message-at.json'));
  const outboundMinAgo = lastOut?.ts ? Math.round((Date.now() - new Date(lastOut.ts).getTime()) / 60000) : null;

  const activity = inferActivityState();

  // Phone context (audio + motion) — returns null if stale / absent
  let phoneCtx = null;
  try {
    phoneCtx = JSON.parse(shSafe(
      `node -e "require('${path.join(TOOLS, 'lib/phone-context.js')}').getLatest().then(r=>console.log(JSON.stringify(r)))"`
    ) || 'null');
  } catch {}

  // Sleep/wake — actual wake time today + last-active yesterday, from the
  // installation's own sleep signal (cliExt().sleepInfo) when it has one.
  let sleepInfo = null;
  try {
    if (typeof cliExt().sleepInfo === 'function') sleepInfo = cliExt().sleepInfo({ TOOLS, shSafe }) || null;
  } catch {}

  // Current location via findme (single call; cached by findme itself)
  let location = null;
  try {
    // `locate me` = the owner's own phone (findme treats it exactly like the owner's name).
    const raw = shSafe(`"${path.join(TOOLS, 'bin/findme')}" locate me --json`);
    location = JSON.parse(raw || 'null');
  } catch {}

  // Scheduled presence from the canonical travel timeline — the authoritative
  // answer to "where is the user". findme is a live GPS/device signal and goes
  // null whenever the phone is stale, which is exactly when hum most needs to
  // know: once the situation snapshot carried where_place=null while
  // `travel where` had the correct city, and hum shipped a ping asserting
  // a different one. Always resolve it (cheap, one query) and expose it
  // separately so consumers can tell the GPS reading from the itinerary.
  let scheduled = null;
  try {
    const raw = shSafe(`"${path.join(TOOLS, 'bin/travel')}" where now --json 2>/dev/null`);
    const parsed = JSON.parse(raw || 'null');
    if (parsed && parsed.metro) scheduled = parsed;
  } catch {}

  // Today's git commits (topic extraction)
  let todayCommits = [];
  try {
    const out = shSafe(`cd ${installRoot()} && git log --oneline --since="today 00:00" --no-color 2>/dev/null`);
    todayCommits = (out || '').trim().split('\n').filter(Boolean).slice(0, 20);
  } catch {}

  // This-week commit topics — compact word-frequency of the last 7d commits'
  // subject lines (minus prefixes like "feat:"/"fix:" and small words). Top 5.
  let weekTopics = [];
  try {
    const raw = shSafe(`cd ${installRoot()} && git log --since="7 days ago" --pretty=%s --no-color 2>/dev/null`) || '';
    const stop = new Set(['the','and','for','with','from','into','that','this','add','adds','added','fix','fixes','fixed','update','updates','updated','feat','chore','docs','test','tests','when','what','have','has','not','now','new','use','uses','used','one','two','all','any','via','per']);
    const freq = {};
    for (const line of raw.split('\n')) {
      const cleaned = line.replace(/^[a-z]+(\([^)]+\))?:/i, '').toLowerCase();
      for (const w of cleaned.split(/[^a-z0-9-]+/)) {
        if (w.length < 4 || stop.has(w)) continue;
        freq[w] = (freq[w] || 0) + 1;
      }
    }
    weekTopics = Object.entries(freq).sort((a,b) => b[1]-a[1]).slice(0, 5).map(([w]) => w);
  } catch {}

  // Weather, cached via apple-weather — skip if binary missing
  let weather = null;
  try {
    const w = shSafe(`"${path.join(TOOLS, 'bin/apple-weather')}" --findme --json 2>/dev/null`);
    if (w) {
      const parsed = JSON.parse(w);
      const cur = parsed?.currentWeather || parsed?.current || null;
      if (cur) weather = { temp_f: cur.temperature != null ? (cur.temperature * 9) / 5 + 32 : null, condition: cur.conditionCode, uv: cur.uvIndex };
    }
  } catch {}

  // HID idle time — minutes since last keyboard/mouse/trackpad input on this
  // Mac. Signals "at desk actively" vs "stepped away / on phone / in a
  // meeting." `ioreg` returns nanoseconds.
  let atDeskMin = null;
  try {
    const raw = shSafe(`ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}'`);
    const ns = parseInt(raw, 10);
    if (Number.isFinite(ns)) atDeskMin = Math.round(ns / 1e9 / 60);
  } catch {}

  // Next — what's coming up. Calendar events in [+0, +120min] plus today's
  // tasks summary. Feeds Sonnet's relevance overlay ("meeting in 30 min"
  // trumps most other candidates).
  let upcomingEvents = [];
  try {
    const raw = shSafe(`/opt/homebrew/bin/gog calendar list ${OWNER_EMAIL ? `--account ${OWNER_EMAIL} ` : ''}--days 1 --max 20 --json 2>/dev/null`) || '';
    const data = JSON.parse(raw || '{}');
    const events = data?.events || data?.items || [];
    const now = Date.now();
    const horizon = now + 2 * 3600 * 1000;
    upcomingEvents = events
      .map((e) => {
        const start = new Date(e.start?.dateTime || e.start?.date || 0).getTime();
        const end = new Date(e.end?.dateTime || e.end?.date || 0).getTime();
        return { start, end, summary: e.summary || '(no title)', location: e.location || null };
      })
      .filter((e) => e.start && e.start >= now - 5 * 60000 && e.start <= horizon)
      .slice(0, 3)
      .map((e) => ({
        in_min: Math.round((e.start - now) / 60000),
        duration_min: Math.max(0, Math.round((e.end - e.start) / 60000)),
        summary: e.summary,
        location: e.location,
      }));
  } catch {}

  // Due-today + overdue tasks — lightweight counts + top-3 titles
  let dueToday = [], overdueCount = 0;
  try {
    const plain = shSafe(`/opt/homebrew/bin/gog tasks list @default --plain 2>/dev/null`) || '';
    const today = new Date().toISOString().slice(0, 10);
    for (const line of plain.split('\n').filter(Boolean)) {
      if (line.includes('completed')) continue;
      const m = line.match(/(\d{4}-\d{2}-\d{2})/);
      if (!m) continue;
      if (m[1] < today) overdueCount++;
      else if (m[1] === today) {
        // gog --plain is TSV; title is field 2
        const parts = line.split('\t');
        dueToday.push((parts[1] || line).slice(0, 80));
      }
    }
    dueToday = dueToday.slice(0, 3);
  } catch {}

  // `findme locate --json` emits a LIST of device records — `_print_devices`
  // does `print(json.dumps(out))` over `matched` — and each record is keyed
  // `lat`/`lon`, with the reverse-geocoded name under `place`.
  //
  // This block read `location.latitude` off the list. Two independent
  // mismatches (array-vs-object, and latitude-vs-lat), so `where.lat` and
  // `where.lon` were ALWAYS null on this path — not when the phone went quiet,
  // always. Every location-aware lane reads those two fields, so `nearby` and
  // `dining` path (a) could never fire: the 2026-08-04 debug trace shows
  // "nearby lane itself found nothing" on every single tick, all day, while the
  // app was posting a fresh fix every few minutes (183 rows into
  // location_history in 12h, plus lat/lon on every chat message).
  //
  // The failure was invisible because `place` still populated — from
  // `scheduled?.label`, the travel timeline — so the snapshot looked healthy
  // ("<City>, <Country> — <lodging name>…") while carrying no coordinates at all. It
  // even self-reported `place_source: "travel_timeline"`, which was the tell.
  //
  // findme itself was never the problem: `cmd_locate` already prefers the
  // Edva app's live GPS over iCloud and returns without touching Find My.
  // The consumer just never unwrapped what it handed back.
  const device = Array.isArray(location) ? location[0] : location;
  // Accept both spellings so this cannot break again if the emitter changes.
  const devLat = device?.lat ?? device?.latitude ?? null;
  const devLon = device?.lon ?? device?.longitude ?? null;
  const devPlace = device?.place || device?.place_name || device?.placeName || null;

  return {
    where: {
      lat: devLat,
      lon: devLon,
      // Live device reading first; fall back to the itinerary so `place` is
      // never null just because the phone went quiet.
      place: devPlace || scheduled?.label || scheduled?.metro || null,
      place_source: devPlace ? 'device' : (scheduled ? 'travel_timeline' : null),
      // Always present when the timeline knows: the AUTHORITATIVE city for
      // today, independent of GPS freshness. Any candidate asserting the user is
      // somewhere else is wrong — see lib/claim-facts.mjs.
      scheduled_metro: scheduled?.metro || null,
      scheduled_label: scheduled?.label || null,
      companions: device?.companions || [],
      activity: device?.activity || null,
      // Reverse-geocoded country, straight from findme. Cheap to carry and it
      // is what picks the right Wikipedia edition for local lore lookups — a
      // local edition often has an article on a small street that en does not.
      country: device?.country || null,
      city: device?.city || null,
    },
    environment: {
      weather,
      audio_class: phoneCtx?.fresh ? phoneCtx.audio_class : null,
      db_bucket: phoneCtx?.fresh ? phoneCtx.ambient_db_bucket : null,
      motion_class: phoneCtx?.motion_class || null,
      phone_context_age_min: phoneCtx?.age_min ?? null,
    },
    time: {
      local_hour: activity.local_hour,
      tz: activity.local_tz,
      activity_state: activity.state,
      inbound_min_ago: inboundMinAgo,
      outbound_min_ago: outboundMinAgo,
      wake_time_today: sleepInfo?.wake_time_today || null,
      sleep_time_yesterday: sleepInfo?.sleep_time_yesterday || null,
      asleep_now: sleepInfo?.asleep_now || false,
    },
    now_activity: {
      at_desk_min: atDeskMin,
    },
    next: {
      upcoming_events: upcomingEvents,
      tasks_due_today: dueToday,
      overdue_count: overdueCount,
    },
    working_on: {
      today_commits: todayCommits,
      week_commit_topics: weekTopics,
    },
  };
}

function cmdHumSituation(args) {
  const fs = require('fs');
  let snap = null;
  try {
    const stat = fs.statSync(SITUATION_CACHE);
    if (Date.now() - stat.mtimeMs < 120 * 1000) {
      snap = JSON.parse(fs.readFileSync(SITUATION_CACHE, 'utf8'));
    }
  } catch {}
  if (!snap || hasFlag(args, '--fresh')) {
    snap = buildSituation();
    try { fs.writeFileSync(SITUATION_CACHE, JSON.stringify(snap)); } catch {}
  }
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(snap, null, 2)); return; }
  console.log(c.bold('Situation') + '\n');
  console.log(`  where:    ${snap.where.place || '—'}  (${snap.where.lat?.toFixed(3)}, ${snap.where.lon?.toFixed(3)})`);
  if (snap.where.companions?.length) console.log(`  with:     ${snap.where.companions.join(', ')}`);
  console.log(`  activity: ${snap.where.activity || '—'}`);
  console.log(`  state:    ${snap.time.activity_state}  (${snap.time.local_hour}:00 ${snap.time.tz})`);
  console.log(`  inbound:  ${snap.time.inbound_min_ago ?? '—'} min ago   outbound: ${snap.time.outbound_min_ago ?? '—'} min ago`);
  if (snap.time.wake_time_today) {
    console.log(`  woke:     ${snap.time.wake_time_today.hm}  (${snap.time.wake_time_today.source})`);
  }
  if (snap.time.sleep_time_yesterday) {
    console.log(`  to bed:   ${snap.time.sleep_time_yesterday.hm} y'day  (${snap.time.sleep_time_yesterday.source})`);
  }
  if (snap.environment.weather) console.log(`  weather:  ${snap.environment.weather.temp_f}F ${snap.environment.weather.condition}`);
  if (snap.environment.audio_class) console.log(`  audio:    ${snap.environment.audio_class}  (${snap.environment.db_bucket || '—'})`);
  if (snap.environment.motion_class) console.log(`  motion:   ${snap.environment.motion_class}`);
  if (snap.now_activity?.at_desk_min !== null && snap.now_activity?.at_desk_min !== undefined) {
    const d = snap.now_activity.at_desk_min;
    console.log(`  at desk:  ${d < 2 ? c.green('active now') : d + ' min idle'}`);
  }
  if (snap.next?.upcoming_events?.length) {
    console.log('\n  ' + c.bold('Next:'));
    for (const e of snap.next.upcoming_events) {
      const when = e.in_min < 0 ? 'started' : `in ${e.in_min}m`;
      console.log(`    ${when}  ${e.summary}${e.location ? ' @ ' + e.location : ''}`);
    }
  }
  if (snap.next?.tasks_due_today?.length || snap.next?.overdue_count) {
    console.log(`  tasks:    ${snap.next.overdue_count} overdue, ${snap.next.tasks_due_today?.length || 0} due today`);
  }
  if (snap.working_on.today_commits?.length) {
    console.log(`  today commits: ${snap.working_on.today_commits.length}`);
  }
  if (snap.working_on.week_commit_topics?.length) {
    console.log(`  week topics:   ${snap.working_on.week_commit_topics.join(', ')}`);
  }
}

// Insight — aggregate the enriched tick trace into metrics mirroring the
// intent file in data/hum-intent.md. Read-only; hum-review uses the
// same computations against its own window.
// Drift audit — compare outcome.sent=true in hum-runs.jsonl vs hum-feedback
// entries in the same window. They should be 1:1. Non-zero delta means the
// send+log plumbing is dropping rows (the 2026-04-11..15 regression this
// whole subsystem was hardened to prevent).
function cmdHumAudit(args) {
  let windowHours = 24;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--window' && args[i + 1]) {
      const m = args[++i].match(/^(\d+)([dh]?)$/);
      if (m) windowHours = parseInt(m[1], 10) * (m[2] === 'd' ? 24 : 1);
    }
  }
  const asJson = hasFlag(args, '--json');
  const cutoff = Date.now() - windowHours * 3600 * 1000;

  function parseJsonl(p) {
    try {
      return fs.readFileSync(p, 'utf8').split('\n').filter(Boolean).map((l) => {
        try { return JSON.parse(l); } catch { return null; }
      }).filter(Boolean);
    } catch (e) {
      if (e.code === 'ENOENT') return [];
      throw e;
    }
  }

  const runs = parseJsonl(HUM_RUNS);
  const feedback = parseJsonl(HUM_FEEDBK);

  // A run "sent" if outcome.sent === true (new schema) OR decision === 'PING'
  // with a ping_id (legacy schema, pre-2026-04-15 rewrite). Accept `ts` or
  // `ran_at` as the timestamp key, and normalize `decision` case — historical
  // rows have varied in both dimensions.
  const sentPings = runs.filter((r) => {
    const ts = Date.parse(r.ts || r.ran_at || '');
    if (!Number.isFinite(ts) || ts < cutoff) return false;
    const newSchema = r.outcome?.sent === true && r.outcome.ping_id;
    const legacy = String(r.decision || '').toUpperCase() === 'PING' && r.ping_id;
    return newSchema || legacy;
  }).map((r) => r.outcome?.ping_id || r.ping_id);

  const feedbackPings = feedback.filter((r) => {
    const ts = Date.parse(r.sent_at || '');
    return Number.isFinite(ts) && ts >= cutoff;
  }).map((r) => r.ping_id);

  const sentSet = new Set(sentPings);
  const feedbackSet = new Set(feedbackPings);
  const missingFeedback = [...sentSet].filter((id) => !feedbackSet.has(id));
  const orphanFeedback = [...feedbackSet].filter((id) => !sentSet.has(id));
  const drift = missingFeedback.length + orphanFeedback.length;

  const report = {
    window_hours: windowHours,
    cutoff_iso: new Date(cutoff).toISOString(),
    pings_sent_in_runs: sentPings.length,
    pings_logged_in_feedback: feedbackPings.length,
    missing_feedback_for_sent: missingFeedback,
    orphan_feedback_no_run: orphanFeedback,
    drift_count: drift,
    healthy: drift === 0,
  };

  if (asJson) {
    console.log(JSON.stringify(report, null, 2));
  } else {
    const mark = drift === 0 ? c.green('OK') : c.red('DRIFT');
    console.log(`${c.bold('hum audit')} (last ${windowHours}h) — ${mark}`);
    console.log(`  sent in runs:      ${report.pings_sent_in_runs}`);
    console.log(`  logged in feedback: ${report.pings_logged_in_feedback}`);
    if (missingFeedback.length) {
      console.log(c.red(`  missing feedback (${missingFeedback.length}):`));
      for (const id of missingFeedback) console.log(`    ${id}`);
    }
    if (orphanFeedback.length) {
      console.log(c.yellow(`  orphan feedback (${orphanFeedback.length}):`));
      for (const id of orphanFeedback) console.log(`    ${id}`);
    }
  }

  process.exit(drift === 0 ? 0 : 1);
}

function cmdHumInsight(args) {
  const fs = require('fs');
  let sinceDays = 7;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--since' && args[i + 1]) {
      const m = args[++i].match(/^(\d+)([dh]?)$/);
      if (m) sinceDays = parseInt(m[1], 10) * (m[2] === 'h' ? 1 / 24 : 1);
    }
  }
  const cutoff = Date.now() - sinceDays * 24 * 3600 * 1000;

  let runs = [], feedback = [], learnings = [];
  try {
    runs = fs.readFileSync(HUM_RUNS, 'utf8').trim().split('\n').filter(Boolean).map((l) => {
      try { return JSON.parse(l); } catch { return null; }
    }).filter(Boolean).filter((r) => new Date(r.ts).getTime() >= cutoff);
  } catch {}
  try {
    feedback = fs.readFileSync(HUM_FEEDBK, 'utf8').trim().split('\n').filter(Boolean).map((l) => {
      try { return JSON.parse(l); } catch { return null; }
    }).filter(Boolean).filter((r) => new Date(r.sent_at || r.ts || 0).getTime() >= cutoff);
  } catch {}
  try {
    learnings = fs.readFileSync(HUM_LEARNINGS, 'utf8').trim().split('\n').filter(Boolean).map((l) => {
      try { return JSON.parse(l); } catch { return null; }
    }).filter(Boolean).filter((r) => new Date(r.answered_at || 0).getTime() >= cutoff);
  } catch {}

  const total = runs.length;
  if (total === 0) {
    console.log(c.dim(`No tick traces in the last ${sinceDays}d.`));
    return;
  }
  const bucket = { silent: 0, info: 0, question: 0, error: 0 };
  const perTopicCandidates = {}, perTopicWins = {}, perTopicErrors = {};
  const scoreDist = [];
  let sent = 0, downgrades = 0, bashGated = 0; // bashGated approximated by "no candidates AND no sonnet call"
  let meetingSuppressed = 0;

  for (const r of runs) {
    const d = r.sonnet?.decision || 'error';
    bucket[d] = (bucket[d] || 0) + 1;
    if (r.outcome?.sent) sent++;
    if (r.outcome?.downgrade_reason) downgrades++;
    // harvest.candidates/errors are normally arrays, but a schema variant has
    // written `candidates` as an int (a count) — `|| []` doesn't guard a truthy
    // non-array, so `for...of` on an int throws. Guard with Array.isArray.
    const cands = Array.isArray(r.harvest?.candidates) ? r.harvest.candidates : [];
    for (const c of cands) {
      const t = c && typeof c === 'object' ? c.topic : null;
      if (t) perTopicCandidates[t] = (perTopicCandidates[t] || 0) + 1;
    }
    const errs = Array.isArray(r.harvest?.errors) ? r.harvest.errors : [];
    for (const e of errs) {
      const t = e && typeof e === 'object' ? e.topic : null;
      if (t) perTopicErrors[t] = (perTopicErrors[t] || 0) + 1;
    }
    if (r.sonnet?.based_on_topic) {
      perTopicWins[r.sonnet.based_on_topic] = (perTopicWins[r.sonnet.based_on_topic] || 0) + 1;
    }
    if (typeof r.sonnet?.score === 'number') scoreDist.push(r.sonnet.score);
  }

  const silentRate = bucket.silent / total;
  const reactedCount = feedback.filter((f) => f.reaction).length;
  const positive = feedback.filter((f) => ['helpful', 'more', '👍'].includes(f.reaction)).length;
  const negative = feedback.filter((f) => ['skip', 'snooze', '👎', '💤'].includes(f.reaction)).length;
  const responseRate = feedback.length ? reactedCount / feedback.length : 0;
  const positiveRate = (positive + negative) ? positive / (positive + negative) : 0;
  const answerRate = bucket.question ? learnings.length / bucket.question : 0;

  // hum-review Step 3 criteria table, computed here (2026-10-04) so the review
  // turn quotes PASS/FAIL instead of re-deriving arithmetic by hand. Rows that
  // need a judgement or a source this CLI does not read (attention hit-rate,
  // LLM-invocation efficiency, the wiki half of memory growth) come back as
  // status "MODEL" with a note — the review fills those in.
  const answerMins = learnings
    .map((l) => (Date.parse(l.answered_at || '') - Date.parse(l.asked_at || '')) / 60000)
    .filter((m) => Number.isFinite(m) && m >= 0)
    .sort((a, b) => a - b);
  const medianAnswerMin = answerMins.length ? answerMins[Math.floor(answerMins.length / 2)] : null;
  const subjectTicks = {};
  for (const r of runs) {
    const subj = r.sonnet?.subject;
    if (subj && (r.sonnet?.decision === 'info' || r.sonnet?.decision === 'question')) subjectTicks[subj] = (subjectTicks[subj] || 0) + 1;
  }
  const dupSubjects = Object.entries(subjectTicks).filter(([, n]) => n > 1).map(([k, n]) => ({ subject: k, ticks: n }));
  const perTopicAttempts = {};
  for (const r of runs) {
    for (const t of Array.isArray(r.harvest?.attempted) ? r.harvest.attempted : []) perTopicAttempts[t] = (perTopicAttempts[t] || 0) + 1;
  }
  const errRates = Object.keys(perTopicErrors).map((t) => ({
    topic: t, errors: perTopicErrors[t], attempts: perTopicAttempts[t] || (perTopicCandidates[t] || 0) + perTopicErrors[t],
  })).map((x) => ({ ...x, rate: x.attempts ? x.errors / x.attempts : 1 }));
  const worstErr = errRates.sort((a, b) => b.rate - a.rate)[0] || null;
  const grade = (value, ok) => (value == null ? 'N/A' : ok ? 'PASS' : 'FAIL');
  const criteria = [
    { criterion: 'Silent rate', value: silentRate, target: '>= 0.85', status: grade(silentRate, silentRate >= 0.85) },
    { criterion: 'Info positive rate', value: (positive + negative) ? positiveRate : null, target: '>= 0.60', status: grade((positive + negative) ? positiveRate : null, positiveRate >= 0.60) },
    { criterion: 'Info response rate', value: feedback.length ? responseRate : null, target: '>= 0.30', status: grade(feedback.length ? responseRate : null, responseRate >= 0.30) },
    { criterion: 'Question answer rate', value: bucket.question ? answerRate : null, target: '>= 0.40', status: grade(bucket.question ? answerRate : null, answerRate >= 0.40) },
    { criterion: 'Median time-to-answer (min)', value: medianAnswerMin, target: '<= 30', status: grade(medianAnswerMin, medianAnswerMin <= 30) },
    { criterion: 'Subject dedup', value: dupSubjects.length, detail: dupSubjects, target: '= 0', status: grade(dupSubjects.length, dupSubjects.length === 0) },
    { criterion: 'Harvester error rate (worst topic)', value: worstErr ? worstErr.rate : 0, detail: errRates, target: '<= 0.10', status: grade(0, !worstErr || worstErr.rate <= 0.10) },
    { criterion: 'Memory growth', value: learnings.length, target: '>= 3 per week', status: 'MODEL', note: `hum-learnings rows only (${learnings.length}); add wiki pages updated in-window` },
    { criterion: 'Attention hit-rate', value: null, target: '>= 0.70', status: 'MODEL', note: 'needs week_commit_topics / upcoming events / 👍-history judgement' },
    { criterion: 'LLM-invocation efficiency', value: null, target: '>= 0.40', status: 'MODEL', note: 'bash-gated skips live in watchdog.log' },
  ];

  if (hasFlag(args, '--json')) {
    console.log(JSON.stringify({
      window_days: sinceDays,
      total, silent_rate: silentRate, bucket,
      info_sent: sent, downgrades,
      info_response_rate: responseRate, info_positive_rate: positiveRate,
      questions_asked: bucket.question, questions_answered: learnings.length, answer_rate: answerRate,
      median_time_to_answer_min: medianAnswerMin,
      per_topic_candidates: perTopicCandidates, per_topic_wins: perTopicWins, per_topic_errors: perTopicErrors,
      criteria,
    }, null, 2));
    return;
  }

  console.log(c.bold(`Hum insight — last ${sinceDays}d`) + '\n');
  console.log(`  ticks:           ${total}`);
  console.log(`  silent:          ${bucket.silent}  (${(silentRate * 100).toFixed(1)}%)  ${silentRate >= 0.85 ? c.green('✓ intent') : c.yellow('below 0.85')}`);
  console.log(`  info:            ${bucket.info} (sent ${sent}, downgraded ${downgrades})`);
  console.log(`  question:        ${bucket.question}  (answered ${learnings.length}, rate ${(answerRate * 100).toFixed(0)}%)  ${answerRate >= 0.4 ? c.green('✓ intent') : c.yellow('below 0.40')}`);
  if (bucket.error) console.log(`  ${c.red('error:          ' + bucket.error)}`);

  console.log('\n  ' + c.bold('Info reactions'));
  console.log(`    response rate:  ${(responseRate * 100).toFixed(0)}%  ${responseRate >= 0.30 ? c.green('✓') : c.yellow('below 0.30')}`);
  console.log(`    positive rate:  ${(positiveRate * 100).toFixed(0)}%  (${positive}👍 / ${negative}👎)  ${positiveRate >= 0.60 ? c.green('✓') : c.yellow('below 0.60')}`);

  console.log('\n  ' + c.bold('Per-topic hit rate (wins ÷ candidates)'));
  const topics = Object.keys(perTopicCandidates).sort();
  for (const t of topics) {
    const cand = perTopicCandidates[t] || 0;
    const wins = perTopicWins[t] || 0;
    const errs = perTopicErrors[t] || 0;
    const attempts = cand + errs;
    const hit = cand ? (wins / cand * 100).toFixed(0) + '%' : '—';
    const errRate = attempts ? (errs / attempts * 100).toFixed(0) + '%' : '0%';
    const errColor = errs / (attempts || 1) > 0.1 ? c.yellow : c.dim;
    console.log(`    ${t.padEnd(18)} cand=${String(cand).padStart(3)}  wins=${String(wins).padStart(3)} (${hit})  ${errColor('err=' + errs + ' (' + errRate + ')')}`);
  }

  if (scoreDist.length) {
    scoreDist.sort((a, b) => a - b);
    const med = scoreDist[Math.floor(scoreDist.length / 2)];
    const p90 = scoreDist[Math.floor(scoreDist.length * 0.9)];
    console.log('\n  ' + c.bold('Sonnet score distribution') + `  median=${med.toFixed(2)}  p90=${p90.toFixed(2)}  (threshold 0.55)`);
  }

  console.log('\n  ' + c.bold('Intent criteria (hum-review Step 3)'));
  for (const k of criteria) {
    const v = k.value == null ? '—' : (typeof k.value === 'number' && !Number.isInteger(k.value) ? k.value.toFixed(2) : String(k.value));
    const col = k.status === 'PASS' ? c.green : k.status === 'FAIL' ? c.red : c.dim;
    console.log(`    ${k.criterion.padEnd(36)} ${v.padStart(6)}  ${k.target.padEnd(14)} ${col(k.status)}`);
  }
}

// edva hum reactions — per-lane reaction-rate detection (backloop
// variant). Hum surfaces a finding through TWO channels, and a lane
// can live in either, so this reads two ledgers:
//
//   1. INFO pings — data/hum-feedback.jsonl, the per-ping ledger every
//      hum info-send appends to (one row per ping: {ping_id, sent_at, lane,
//      reaction, reaction_at, ...}) — the same file `edva hum insight`
//      already reads. Engagement = a non-null `reaction` (a tapback token).
//   2. QUESTIONS — data/hum-runs.jsonl rows whose `sonnet.decision` is
//      "question". These never get a hum-feedback.jsonl row at all; their
//      answers land in data/hum-learnings.jsonl (written by
//      bin/hum-answer), keyed by the run's `outcome.question_id`.
//      Engagement = that id appearing in hum-learnings.jsonl.
//
// For each lane in the window:
//   surfaced  = info_surfaced + question_surfaced
//   reacted   = info_reacted  + question_answered
//   positive  = reaction ∈ {helpful, more, 👍}   (same vocabulary as insight)
//   negative  = reaction ∈ {skip, snooze, 👎, 💤}
//   other     = engaged without valence — includes every answered question
//
// response_rate = reacted / surfaced (how often the user engages with the lane)
// positive_rate = positive / (positive + negative) (how often engagement is positive)
//
// Flags a lane as DECAYING when surfaced >= 3 AND response_rate < 0.10
// (lots of pings, no engagement) or when info_surfaced >= 5 AND
// positive_rate < 0.40 (the user reacts but mostly negatively). hum-review
// reads --json output to surface decay candidates per topic.
//
// Previously sourced from data/suggestion-history.jsonl's `kind:"surfaced"`
// rows keyed by subject_key — but nothing in the current codebase writes that
// kind (appendSurfaced in lib/suggestion-history.mjs has no callers), so
// `surfaced` there was frozen near zero while `hum insight` (sourced from
// hum-runs.jsonl + hum-feedback.jsonl) kept counting normally. That produced
// the >30x disagreement flagged in the 2026-07-26 hum-review (Proposal 5).
// hum-feedback.jsonl is populated on every real send and already carries
// `lane` directly (no subject_key-prefix guessing needed), so it's both the
// more complete and the simpler source.
//
// Questions were folded in on 2026-07-30, closing the successor to that same
// gap: hum-feedback.jsonl only ever gets a row for an *info* decision, so a
// lane that mostly asks questions was invisible here. In the 14d to 2026-07-30
// there were 44 question ticks contributing nothing — `ideas` alone was short
// 17 real surfacings (8 counted vs 25 actual), and `location_context` had 8
// sent-and-unanswered questions that the tool could not see at all. A lane
// the user answers fine through the question channel could therefore be flagged
// `low_engagement` on the strength of its info pings alone. Three deliberate
// choices in that fold:
//   · Only questions with `outcome.sent === true` AND an `outcome.question_id`
//     count as surfaced. 11 of those 44 were never actually sent (downgraded
//     by `pending_question_active`, `precheck_suppressed`, `wiki_settled`,
//     a killed hung send, ...). Counting an unsent question as surfaced would
//     depress response_rate and manufacture the very false decay signal this
//     fold exists to remove.
//   · An answered question counts toward `reacted`/`other`, never
//     `positive`/`negative`. hum-answer records free text, which carries no
//     thumbs-up/down valence to read; inventing one would be a fabricated
//     sentiment score.
//   · `mostly_negative` therefore still gates on `info_surfaced >= 5`, NOT on
//     the combined total — preserving its pre-2026-07-30 behavior exactly.
//     Questions add no valence, so letting them inflate that gate would let a
//     3-reaction sample trip a valence verdict it is far too small to support.
function cmdHumReactions(args) {
  const fsLocal = require('fs');
  let sinceDays = 7;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--since' && args[i + 1]) {
      const m = args[++i].match(/^(\d+)([dh]?)$/);
      if (m) sinceDays = parseInt(m[1], 10) * (m[2] === 'h' ? 1 / 24 : 1);
    }
  }
  const cutoffMs = Date.now() - sinceDays * 24 * 3600 * 1000;
  const readJsonl = (p) => {
    try {
      return fsLocal.readFileSync(p, 'utf8').trim().split('\n').filter(Boolean)
        .map((l) => { try { return JSON.parse(l); } catch { return null; } })
        .filter(Boolean);
    } catch { return null; }
  };
  const feedbackAll = readJsonl(HUM_FEEDBK);
  const runsAll = readJsonl(HUM_RUNS);
  if (feedbackAll === null && runsAll === null) {
    if (hasFlag(args, '--json')) { console.log(JSON.stringify({ window_days: sinceDays, lanes: {}, total_surfaced: 0, total_reacted: 0 }, null, 2)); return; }
    console.log(c.dim(`hum-feedback.jsonl / hum-runs.jsonl not readable; no reactions to summarize.`));
    return;
  }
  const rows = (feedbackAll || []).filter((r) => new Date(r.sent_at || r.ts || 0).getTime() >= cutoffMs);
  const runs = (runsAll || []).filter((r) => new Date(r.ts || 0).getTime() >= cutoffMs);
  // Answered-question ids. Deliberately NOT windowed: a question surfaced
  // inside the window can only have been answered at or after it was asked, so
  // windowing this set can only produce false negatives (an edge-of-window
  // question whose answer parses oddly), never false positives. Rows without
  // an `id` are not question answers at all — hum-learnings.jsonl also carries
  // canary-feedback/chat rule rows, which carry no id and must not count.
  const answeredIds = new Set((readJsonl(HUM_LEARNINGS) || []).map((r) => r.id).filter(Boolean));

  // Same reaction-token vocabulary `cmdHumInsight` uses, so the two commands
  // never disagree on what counts as positive vs. negative.
  const POSITIVE_TOKENS = ['helpful', 'more', '👍'];
  const NEGATIVE_TOKENS = ['skip', 'snooze', '👎', '💤'];

  // One row per real send — no subject-centric dedup needed (unlike the old
  // suggestion-history path, a ping_id here is never double-counted).
  const lanes = {};
  const touch = (lane) => {
    if (!lanes[lane]) lanes[lane] = { info_surfaced: 0, question_surfaced: 0, surfaced: 0, reacted: 0, positive: 0, negative: 0, other: 0 };
    return lanes[lane];
  };
  for (const r of rows) {
    const lane = r.lane || 'unknown';
    const slot = touch(lane);
    slot.info_surfaced += 1;
    slot.surfaced += 1;
    if (r.reaction) {
      slot.reacted += 1;
      if (POSITIVE_TOKENS.includes(r.reaction)) slot.positive++;
      else if (NEGATIVE_TOKENS.includes(r.reaction)) slot.negative++;
      else slot.other++;
    }
  }
  // Question surfacings. Only ones that actually reached the user AND carry an
  // id we can match an answer against — see the header comment for why an
  // unsent question must never count as surfaced.
  for (const r of runs) {
    if (r.sonnet?.decision !== 'question') continue;
    const out = r.outcome || {};
    if (out.sent !== true || !out.question_id) continue;
    const slot = touch(r.sonnet.based_on_topic || 'unknown');
    slot.question_surfaced += 1;
    slot.surfaced += 1;
    if (answeredIds.has(out.question_id)) {
      slot.reacted += 1;
      slot.other += 1; // engaged, but a free-text answer carries no valence
    }
  }
  const totalSurfaced = Object.values(lanes).reduce((a, b) => a + b.surfaced, 0);
  const totalReacted = Object.values(lanes).reduce((a, b) => a + b.reacted, 0);
  // Per-lane derived metrics + decay flag.
  const perLane = {};
  for (const [lane, s] of Object.entries(lanes)) {
    const responseRate = s.surfaced ? s.reacted / s.surfaced : 0;
    const known = s.positive + s.negative;
    const positiveRate = known ? s.positive / known : null;
    let decay = null;
    // `mostly_negative` gates on info_surfaced (the valence-bearing
    // population), not the combined total — questions contribute no
    // positive/negative signal, so they must not inflate this gate.
    if (s.info_surfaced >= 5 && positiveRate !== null && positiveRate < 0.40) decay = 'mostly_negative';
    else if (s.surfaced >= 3 && responseRate < 0.10) decay = 'low_engagement';
    perLane[lane] = { ...s, response_rate: responseRate, positive_rate: positiveRate, decay };
  }
  if (hasFlag(args, '--json')) {
    console.log(JSON.stringify({ window_days: sinceDays, total_surfaced: totalSurfaced, total_reacted: totalReacted, lanes: perLane }, null, 2));
    return;
  }
  console.log(c.bold(`Hum reactions — last ${sinceDays}d`) + '\n');
  console.log(`  total surfaced: ${totalSurfaced}    total reacted: ${totalReacted}    overall response: ${totalSurfaced ? ((totalReacted / totalSurfaced) * 100).toFixed(0) : 0}%\n`);
  const laneNames = Object.keys(perLane).sort();
  if (laneNames.length === 0) { console.log(c.dim('  (no surfaced/reaction rows in window)')); return; }
  console.log('  LANE             SURF  INFO    Q  RXN  POS  NEG  RESPONSE  POSITIVE  DECAY');
  for (const lane of laneNames) {
    const s = perLane[lane];
    const rr = (s.response_rate * 100).toFixed(0).padStart(3) + '%';
    const pr = s.positive_rate === null ? ' n/a' : (s.positive_rate * 100).toFixed(0).padStart(3) + '%';
    const decayCol = s.decay ? c.yellow(s.decay) : '';
    console.log(`  ${lane.padEnd(16)} ${String(s.surfaced).padStart(4)}  ${String(s.info_surfaced).padStart(4)}  ${String(s.question_surfaced).padStart(3)}  ${String(s.reacted).padStart(3)}  ${String(s.positive).padStart(3)}  ${String(s.negative).padStart(3)}  ${rr.padStart(8)}  ${pr.padStart(8)}  ${decayCol}`);
  }
}

// edva hum signal — the hum-improvement-loop dashboard. Reads the daily
// time series in data/hum-metrics-state.json (canonical schema in
// data/hum-improvement-loop.md). Shows today vs 7d rolling vs 30d
// baseline + per-lane breakdown + open decay events.
function cmdHumSignal(args) {
  const fsLocal = require('fs');
  const STATE = path.join(TOOLS, 'data/hum-metrics-state.json');
  let sinceDays = 14;
  let laneFilter = null;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--since' && args[i + 1]) {
      const m = args[++i].match(/^(\d+)d?$/); if (m) sinceDays = parseInt(m[1], 10);
    } else if (args[i] === '--lane' && args[i + 1]) {
      laneFilter = args[++i];
    }
  }
  let state;
  try { state = JSON.parse(fsLocal.readFileSync(STATE, 'utf8')); }
  catch {
    if (hasFlag(args, '--json')) { console.log(JSON.stringify({ daily: [], decay_events: [] })); return; }
    console.log(c.dim('hum-metrics-state.json not present yet — run `hum-metrics-collect` first.'));
    return;
  }
  const daily = (state.daily || []).slice(-sinceDays);
  const decayEvents = (state.decay_events || []).slice(-20);
  if (hasFlag(args, '--json')) {
    console.log(JSON.stringify({ daily, decay_events: decayEvents, lane: laneFilter }, null, 2));
    return;
  }
  if (daily.length === 0) { console.log(c.dim('(no daily rows yet)')); return; }
  const last = daily[daily.length - 1];
  console.log(c.bold(`Hum signal — last ${sinceDays}d (latest: ${last.date})`) + '\n');
  // Headline (latest row).
  const fmt = (n, d = 3) => n === null || n === undefined ? c.dim('n/a') : Number(n).toFixed(d);
  console.log(c.bold('  Latest day'));
  console.log(`    surfaced:           ${last.surfaced}`);
  console.log(`    signal_score_raw:   ${fmt(last.signal_score_raw, 2)}`);
  console.log(`    signal_per_surfaced:${' '}${fmt(last.signal_per_surfaced)}`);
  console.log(`    surface_rate:       ${fmt(last.surface_rate)}`);
  console.log(`    silent_rate:        ${fmt(last.silent_rate)}`);
  const r7 = last.rolling_7d;
  const r30 = last.rolling_30d_baseline;
  if (r7) {
    console.log(c.bold('\n  Rolling 7d'));
    console.log(`    signal_per_surfaced:${' '}${fmt(r7.signal_per_surfaced)}    surface_rate: ${fmt(r7.surface_rate)}`);
  }
  if (r30) {
    console.log(c.bold('\n  Rolling 30d baseline'));
    console.log(`    signal_per_surfaced:${' '}${fmt(r30.signal_per_surfaced)}    surface_rate: ${fmt(r30.surface_rate)}`);
  }
  // Per-lane (latest day; or filtered).
  const lanes = last.lane_yield || {};
  const laneKeys = Object.keys(lanes).filter(k => !laneFilter || k === laneFilter).sort();
  if (laneKeys.length) {
    console.log(c.bold('\n  Per-lane (latest day)'));
    console.log('    LANE             CAND  SURF  LOVE  UP   DOWN  SNOOZ  SIG/SURF');
    for (const lane of laneKeys) {
      const ly = lanes[lane];
      const rx = ly.reactions || {};
      const cell = (n) => String(n || 0).padStart(4);
      const sps = fmt(ly.signal_per_surfaced);
      console.log(`    ${lane.padEnd(16)} ${cell(ly.candidates)}  ${cell(ly.surfaced)}  ${cell(rx.love)}  ${cell(rx.up)}  ${cell(rx.down)}  ${cell(rx.snooze)}   ${sps.padStart(6)}`);
    }
  }
  // Decay events.
  if (decayEvents.length) {
    console.log(c.bold('\n  Recent decay events'));
    for (const ev of decayEvents) {
      const ts = (ev.ts || '').slice(0, 19);
      const lane = ev.lane ? `[${ev.lane}]` : '[global]';
      const extra = ev.type === 'lane_decay_silent' ? `surfaced=${ev.surfaced_in_window} silent_days=${ev.days_silent}`
                  : ev.type === 'global_decay_drop' ? `Δ=${ev.delta_pct} today=${ev.today_3d} base=${ev.baseline_7d}`
                  : ev.type.includes('surface_rate') ? `rolling_3d=${ev.rolling_3d}`
                  : '';
      console.log(`    ${c.yellow(ev.type.padEnd(24))} ${lane.padEnd(10)} ${extra}    ${c.dim(ts)}`);
    }
  }
  // Sparkline (signal_per_surfaced over window).
  const series = daily.map(r => r.signal_per_surfaced).filter(v => v !== null);
  if (series.length >= 3) {
    const min = Math.min(...series), max = Math.max(...series);
    const bars = '▁▂▃▄▅▆▇█';
    const scale = (max - min) || 1;
    const spark = daily.map(r => {
      const v = r.signal_per_surfaced;
      if (v === null) return c.dim('·');
      const idx = Math.min(7, Math.floor(((v - min) / scale) * 7));
      return bars[idx];
    }).join('');
    console.log(c.bold('\n  Signal/surfaced trend ') + c.dim(`(min=${fmt(min)}, max=${fmt(max)})`));
    console.log(`    ${spark}`);
  }
}

// edva hum intervention — attribution ledger for the hum-improvement-loop.
// Subcommands:
//   list                     — open + measured interventions
//   record <id> <hypothesis> — manually add an entry (auto-impl flow does this too)
//   measure                  — re-run attribution (also runs in hum-metrics-collect --measure)
function cmdHumIntervention(args) {
  const fsLocal = require('fs');
  const LEDGER = path.join(TOOLS, 'data/hum-interventions.jsonl');
  const sub = args[0];
  if (!sub || sub === 'list' || sub === 'help' || sub === '--help') {
    let rows = [];
    try { rows = fsLocal.readFileSync(LEDGER, 'utf8').trim().split('\n').filter(Boolean).map(l => JSON.parse(l)); }
    catch { rows = []; }
    if (hasFlag(args, '--json')) { console.log(JSON.stringify(rows, null, 2)); return; }
    if (rows.length === 0) { console.log(c.dim('(no interventions logged yet)')); return; }
    console.log(c.bold(`Hum interventions (${rows.length})`) + '\n');
    for (const r of rows) {
      const m = r.measurement;
      const verdict = m ? `${m.verdict} (Δ=${m.delta_signal_per_surfaced})` : c.yellow('pending');
      console.log(`  ${c.bold(r.id)}  ${r.lane || 'global'}  ${verdict}`);
      console.log(`    applied: ${r.applied_at}  commit: ${(r.commit || '').slice(0,7)}`);
      console.log(`    ${r.hypothesis || ''}\n`);
    }
    return;
  }
  if (sub === 'record') {
    const id = args[1]; const hypothesis = args.slice(2).join(' ');
    if (!id || !hypothesis) die('hum intervention record <id> <hypothesis>');
    const row = {
      id, applied_at: new Date().toISOString(),
      commit: (require('child_process').execSync('git rev-parse --short HEAD').toString().trim()),
      lane: null, hypothesis, predicted_effect: {},
      baseline_window: null,
      measure_at: new Date(Date.now() + 7 * 86400 * 1000).toISOString(),
    };
    fsLocal.appendFileSync(LEDGER, JSON.stringify(row) + '\n');
    console.log(`recorded ${id}`);
    return;
  }
  if (sub === 'measure') {
    const { spawnSync } = require('child_process');
    const collect = path.join(TOOLS, 'bin/hum-metrics-collect');
    if (!fs.existsSync(collect)) die('hum intervention measure: this installation has no bin/hum-metrics-collect');
    const r = spawnSync(collect,
      ['--measure', '--dry-run'], { encoding: 'utf8' });
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
    return;
  }
  die(`unknown: hum intervention ${sub}. Try: list | record | measure`);
}

// edva hum lane — manual lever for the auto-quiesce mechanism
// (lib/hum-lane-quiesce.mjs). hum-sense's own housekeeping already
// auto-quiesces a lane after 2 consecutive expired-unanswered lane_diagnosis
// questions and auto-re-enables it on a positive reaction; this is the
// explicit path for "bring back <lane>" or a manual pause, same shared
// library so both mechanisms log to the same state + intervention ledger.
async function cmdHumLane(args) {
  const { quiesceLane, reenableLane, laneQuiesceStatus } =
    await import(path.join(TOOLS, 'lib/hum-lane-quiesce.mjs'));
  const sub = args[0];
  if (!sub || sub === 'status' || sub === 'help' || sub === '--help') {
    const rows = laneQuiesceStatus();
    if (hasFlag(args, '--json')) { console.log(JSON.stringify(rows, null, 2)); return; }
    console.log(c.bold('Hum lanes') + '\n');
    for (const r of rows) {
      const state = r.enabled ? c.green('enabled') : c.yellow('disabled');
      const streak = r.consecutive_expired ? c.dim(`  (unanswered streak: ${r.consecutive_expired})`) : '';
      console.log(`  ${r.lane.padEnd(18)} ${state}${streak}`);
      if (!r.enabled && r.quiesced_reason) console.log(c.dim(`    ${r.quiesced_reason}`));
    }
    return;
  }
  const lane = args[1];
  if (!lane) die(`hum lane ${sub}: lane name required. Try: edva hum lane status | enable <name> [reason] | disable <name> [reason]`);
  const reason = args.slice(2).join(' ') || null;
  if (sub === 'enable') {
    const result = reenableLane(lane, reason);
    if (!result) { console.log(c.red(`unknown lane: ${lane}`)); return; }
    console.log(result.changed ? c.green(`${lane} re-enabled.`) : c.dim(`${lane} was already enabled.`));
    return;
  }
  if (sub === 'disable') {
    const result = quiesceLane(lane, reason);
    if (!result) { console.log(c.red(`unknown lane: ${lane}`)); return; }
    console.log(result.changed ? c.yellow(`${lane} disabled.`) : c.dim(`${lane} was already disabled.`));
    return;
  }
  die(`unknown: hum lane ${sub}. Try: status | enable <name> [reason] | disable <name> [reason]`);
}

// Infer the user's current activity state from existing signals. Reads
// phone-channel-cursor.json (last inbound) + user-timezone.json (local TZ),
// classifies as active / winding_down / sleeping / waking. Used by
// trigger-hum.sh as a soft gate and exposed here for ad-hoc inspection.
function inferActivityState() {
  const fs = require('fs');
  const dataDir = path.join(TOOLS, 'data');
  const readJson = (p) => { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return null; } };
  const cursor = readJson(`${dataDir}/phone-channel-cursor.json`);
  const tzdata = readJson(`${dataDir}/user-timezone.json`);
  const tz = (tzdata && tzdata.timezone) || instance().tz;
  const lastSeenAt = cursor && cursor.lastSeenAt ? new Date(cursor.lastSeenAt) : null;
  const ageMin = lastSeenAt ? Math.round((Date.now() - lastSeenAt.getTime()) / 60000) : null;
  const localHour = parseInt(
    new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: '2-digit', hour12: false }).format(new Date()),
    10
  );
  let state = 'active';
  let reason = `${localHour}:00 local, inbound ${ageMin ?? '?'}m ago`;

  // A device signal the installation has (cliExt().activityOverride: the phone
  // locked since bed hours → sleeping, whatever the clock says) beats the clock
  // rules below; no signal, or a stale one, falls through to them.
  let override = null;
  try {
    if (typeof cliExt().activityOverride === 'function') override = cliExt().activityOverride({ tz, localHour, ageMin, dataDir, readJson });
  } catch {}
  if (override && override.state) {
    return { state: override.state, last_inbound_min_ago: ageMin, local_hour: localHour, local_tz: tz, reason: override.reason };
  }

  if (localHour >= 1 && localHour < 7) {
    state = 'sleeping';
    reason = `sleep window ${localHour}:00 local`;
  } else if ((localHour >= 22 || localHour < 1) && (ageMin === null || ageMin >= 30)) {
    state = 'winding_down';
    reason = `late (${localHour}:00) + no phone activity ${ageMin ?? '?'}m`;
  } else if (localHour >= 7 && localHour < 9 && ageMin !== null && ageMin < 30) {
    state = 'waking';
    reason = `morning + fresh phone activity ${ageMin}m ago`;
  }
  return { state, last_inbound_min_ago: ageMin, local_hour: localHour, local_tz: tz, reason };
}

function cmdContext(args) {
  const ctxBuilder = require(path.join(TOOLS, 'lib/edva-context.js'));
  const skipCache = hasFlag(args, '--fresh');
  const ctx = ctxBuilder.build({ skipCache });
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(ctx, null, 2)); return; }
  console.log(c.bold('Edva Context') + '\n');
  console.log(`  built_at: ${ctx.built_at}`);
  console.log(`\n  ${c.bold('Profile')}      ${Object.keys(ctx.profile).join(', ')}`);
  console.log(`  ${c.bold('Tastes')}       ${Object.keys(ctx.tastes).join(', ')}`);
  console.log(`  ${c.bold('Projects')}     ${Object.keys(ctx.projects).join(', ')}`);
  console.log(`\n  ${c.bold('Knowledge sources')} (${Object.keys(ctx.knowledge).length})`);
  for (const [k, v] of Object.entries(ctx.knowledge)) {
    console.log(`    ${k.padEnd(15)} ${c.dim(v.via)}`);
  }
  console.log(`\n  ${c.bold('Recent')}`);
  console.log(`    today commits:    ${ctx.recent.today_commits.length}`);
  console.log(`    today triage:     P1=${ctx.recent.today_triage.p1 || 0} P2=${ctx.recent.today_triage.p2 || 0} P3=${ctx.recent.today_triage.p3 || 0}`);
  console.log(`    hum runs 7d:      ${ctx.recent.counts.hum_runs_7d}`);
  console.log(`    hum feedback 14d: ${ctx.recent.counts.hum_feedback_14d}`);
  console.log(`    hum learnings 30d:${ctx.recent.counts.hum_learnings_30d}`);
  console.log(`    watchlist notify: ${ctx.recent.counts.watchlist_notify} shows`);
}

function cmdActivity(args) {
  const out = inferActivityState();
  if (hasFlag(args, '--state-only')) { console.log(out.state); return; }
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(out)); return; }
  console.log(c.bold('Activity State') + '\n');
  console.log(`  state:     ${out.state}`);
  console.log(`  inbound:   ${out.last_inbound_min_ago ?? '—'} min ago`);
  console.log(`  local:     ${out.local_hour}:00 ${out.local_tz}`);
  console.log(`  reason:    ${out.reason}`);
}

// ========================================================================
// MAIN DISPATCH
// ========================================================================
const [, , cmd, ...args] = process.argv;

// edva watchdog — summarize watchdog-incidents/.
// Each file in the incident dir is a per-incident probe state:
//   <key>             — consecutive-failure counter (integer)
//   <key>.green_streak — consecutive-recovery counter (integer)
//   <key>.alerted     — touched when an alert was sent (mtime is alert time)
//   <key>.alert_count — alerts within the current max_window
//   <key>.alert_first — mtime is first alert in the window
// Read shape from agent/scripts/watchdog.sh incident_seen / incident_should_alert.
function cmdWatchdog(args) {
  const sub = args[0];
  if (sub && !sub.startsWith('--') && sub !== 'status') {
    console.error(c.red(`unknown edva watchdog subcommand: ${sub}`));
    console.error('Usage: edva watchdog [status] [--json]');
    process.exit(1);
  }
  const incidentDir = installTools("data/watchdog-incidents");
  let entries;
  try { entries = fs.readdirSync(incidentDir); } catch { entries = []; }
  // Group by base key.
  const byKey = {};
  for (const f of entries) {
    let key = f, kind = 'failures';
    if (f.endsWith('.green_streak')) { key = f.slice(0, -'.green_streak'.length); kind = 'green_streak'; }
    else if (f.endsWith('.alerted')) { key = f.slice(0, -'.alerted'.length); kind = 'alerted_mtime'; }
    else if (f.endsWith('.alert_count')) { key = f.slice(0, -'.alert_count'.length); kind = 'alert_count'; }
    else if (f.endsWith('.alert_first')) { key = f.slice(0, -'.alert_first'.length); kind = 'alert_first_mtime'; }
    if (!byKey[key]) byKey[key] = {};
    const full = path.join(incidentDir, f);
    try {
      if (kind === 'failures' || kind === 'green_streak' || kind === 'alert_count') {
        byKey[key][kind] = parseInt(fs.readFileSync(full, 'utf8').trim(), 10) || 0;
      } else {
        byKey[key][kind] = new Date(fs.statSync(full).mtimeMs).toISOString();
      }
    } catch {}
  }
  const rows = Object.entries(byKey).map(([key, v]) => ({ key, ...v })).sort((a, b) => a.key.localeCompare(b.key));
  if (args.includes('--json')) {
    console.log(JSON.stringify({ incidents: rows, count: rows.length }, null, 2));
    return;
  }
  if (rows.length === 0) { console.log(c.dim('no watchdog incidents on disk — all probes clean')); return; }
  console.log(c.bold(`Watchdog incidents (${rows.length})\n`));
  console.log('KEY                              FAILS  GREEN  ALERTS  LAST_ALERT');
  for (const r of rows) {
    const fails = r.failures ?? 0;
    const green = r.green_streak ?? 0;
    const alerts = r.alert_count ?? 0;
    const last = r.alerted_mtime ?? '-';
    const failsStr = fails > 0 ? c.yellow(String(fails).padEnd(5)) : String(fails).padEnd(5);
    console.log(`${r.key.padEnd(32)} ${failsStr}  ${String(green).padEnd(5)}  ${String(alerts).padEnd(6)}  ${last}`);
  }
}

// --- whereami / host identity ---
// Which physical machine is this? Sessions used to guess from a cwd path
// string and get it backwards ("laptop, nothing running" while on the
// production host with everything healthy). Resolves deterministically via
// lib/host-identity.js (hostname/alias → hardware-UUID fallback) against
// system/hosts.json.
function cmdWhereami(args) {
  const { resolveHost, hostBanner } = require(path.join(TOOLS, 'lib/host-identity.js'));
  const h = resolveHost();
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(h, null, 2)); return; }
  if (hasFlag(args, '--banner')) { console.log(hostBanner(h)); return; }
  if (hasFlag(args, '--role')) { console.log(h.role); process.exit(h.known ? 0 : 1); }
  const roleColor = h.isProduction ? c.green : (h.known ? c.cyan : c.yellow);
  console.log(roleColor(c.bold(h.known ? h.role.toUpperCase() : 'UNKNOWN')) + c.dim(` (${h.label})`));
  console.log(c.dim('hostname: ') + h.hostname);
  console.log(c.dim('uuid:     ') + (h.uuid || 'n/a'));
  if (h.notes) console.log(c.dim('notes:    ') + h.notes);
  if (!h.known) {
    console.log(c.yellow('\nUnregistered host — not the production Edva host. Add it to system/hosts.json (hostname + uuid + role) so sessions self-identify.'));
  }
  console.log(c.dim('\n⚠ The default Bash-tool sandbox masks localhost + process lists (pgrep/launchctl/curl); run unsandboxed to verify Edva service health.'));
}

const dispatch = {
  tasks: cmdTasks,
  whereami: cmdWhereami,
  host: cmdWhereami,
  status: cmdStatus,
  services: cmdServices,
  logs: cmdLogs,
  cron: cmdCron,
  git: cmdGit,
  ci: cmdCi,
  triage: cmdTriage,
  hum: cmdHum,
  restart: cmdRestart,
  arch: cmdArch,
  where: cmdWhere,
  doctor: cmdDoctor,
  cost: cmdCost,
  activity: cmdActivity,
  context: cmdContext,
  watchdog: cmdWatchdog,
};

// --- CLI extensions (cli.d/) ---
// An installation adds its own subcommands without editing this file: each
// bin/cli.d/<name>.mjs (next to this CLI) default-exports
//   { name?: "<subcommand>" (default: the file name), summary: "<one line>",
//     usage?: "<name> <args>", async run(args, ctx) }
// ctx = { ROOT, TOOLS, HOME, OWNER, c, table, hasFlag, getFlag, die }.
// The built-in subcommands win on a name; a module that fails to load is
// reported and skipped. `edva help` lists them under EXTENSIONS. Contract
// and examples: bin/cli.d/README.md.
const CLI_D = path.join(__dirname, 'cli.d');
function cliExtensionFiles() {
  try { return fs.readdirSync(CLI_D).filter((f) => f.endsWith('.mjs') && !f.startsWith('_')).sort(); }
  catch { return []; }
}
async function loadCliExtensions() {
  const { pathToFileURL } = require('url');
  const out = [];
  for (const f of cliExtensionFiles()) {
    try {
      const mod = await import(pathToFileURL(path.join(CLI_D, f)).href);
      const ext = mod.default || mod;
      const name = ext.name || f.replace(/\.mjs$/, '');
      if (typeof ext.run !== 'function') { console.error(c.yellow(`cli.d/${f}: no run(args, ctx) — skipped`)); continue; }
      if (dispatch[name] || name === 'help' || out.some((e) => e.name === name)) { console.error(c.yellow(`cli.d/${f}: '${name}' is already a subcommand — skipped`)); continue; }
      out.push({ name, summary: ext.summary || '', usage: ext.usage || name, run: ext.run });
    } catch (e) {
      console.error(c.yellow(`cli.d/${f}: failed to load: ${e.message}`));
    }
  }
  return out;
}
const cliCtx = { ROOT, TOOLS, HOME, OWNER, c, table, hasFlag, getFlag, die };

if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
  if (!cliExtensionFiles().length) { cmdHelp(); process.exit(0); }
  loadCliExtensions().then((ext) => { cmdHelp(ext); process.exit(0); });
} else if (dispatch[cmd]) {
  dispatch[cmd](args);
} else {
  loadCliExtensions().then(async (ext) => {
    const e = ext.find((x) => x.name === cmd);
    if (!e) { console.error(c.red(`unknown subcommand: ${cmd}`) + '\n'); cmdHelp(ext); process.exit(1); }
    try { await e.run(args, cliCtx); }
    catch (err) { die(`${cmd}: ${err && err.message ? err.message : err}`); }
  });
}
