function cmdTriagePause() {
  if (fs.existsSync(PAUSE_FLAG)) { console.log(c.yellow('already paused')); return; }
  fs.writeFileSync(PAUSE_FLAG, new Date().toISOString() + '\n');
  console.log(c.yellow('⏸ triage paused'));
  console.log(c.dim('  gmail-channel will drop notifications (historyId still saved).'));
  console.log(c.dim('  Note: takes effect immediately for NEW gmail-channel events.'));
  console.log(c.dim('  Use `edva triage resume` to re-enable.'));
}

function cmdTriageResume() {
  if (!fs.existsSync(PAUSE_FLAG)) { console.log(c.dim('not paused')); return; }
  const since = fs.readFileSync(PAUSE_FLAG, 'utf8').trim();
  fs.unlinkSync(PAUSE_FLAG);
  console.log(c.green('▶ triage resumed') + c.dim(` (was paused since ${since})`));
  // Dispatch CATCH UP task so ops-agent processes emails missed during pause
  const body = JSON.stringify({ task: `CATCH UP: Triage was paused since ${since}. Fetch all emails received since the last saved historyId and triage each one.` });
  const { code, stderr } = postWebhook('http://localhost:9092', body);
  if (code.startsWith('2')) console.log(c.green('  ✓ dispatched CATCH UP to ops-agent'));
  else {
    console.log(c.yellow(`  catch-up dispatch failed (HTTP ${code}) — ops-agent may not be listening`));
    if (stderr) console.log(c.dim('  stderr: ') + stderr);
  }
}

function cmdTriageReclassify(args) {
  const msgId = args.find(a => !a.startsWith('--'));
  if (!msgId) die('reclassify: missing <messageId>');
  // messageId validation: Gmail IDs are hex, 14-20 chars typically
  if (!/^[a-zA-Z0-9_-]{8,40}$/.test(msgId)) die(`reclassify: messageId looks invalid (got "${msgId}")`);
  const body = JSON.stringify({ task: `RECLASSIFY: ${msgId}` });
  const { code, stderr } = postWebhook('http://localhost:9092', body);
  if (code.startsWith('2')) console.log(c.green('✓ dispatched: ') + c.bold(`RECLASSIFY ${msgId}`));
  else {
    console.error(c.red(`✗ dispatch failed (HTTP ${code})`));
    if (stderr) console.error(c.dim('  stderr: ') + stderr);
    process.exit(1);
  }
}

function cmdTriageResolve(args) {
  const topic = args.filter(a => !a.startsWith('--')).join(' ').trim();
  if (!topic) die('resolve: missing <topic>. Usage: edva triage resolve "<topic text>"');
  if (topic.length > 300) die('resolve: topic too long (>300 chars)');
  const body = JSON.stringify({ task: `RESOLVE P1: ${topic}`, source: 'edva-triage-resolve' });
  const { code, stderr } = postWebhook('http://localhost:9092', body);
  if (code.startsWith('2')) console.log(c.green('✓ dispatched: ') + c.bold(`RESOLVE P1: ${topic}`));
  else {
    console.error(c.red(`✗ dispatch failed (HTTP ${code})`));
    if (stderr) console.error(c.dim('  stderr: ') + stderr);
    process.exit(1);
  }
}

// --- restart ---
// Bearer token for authenticated supervisor POSTs (ops :9093 gates /restart on
// it; chat :9094 does not). Absent file → null (ops auth degrades open).
function readWebhookToken() {
  try { return fs.readFileSync(path.join(TOOLS, 'secrets/webhook-token'), 'utf8').trim() || null; }
  catch { return null; }
}

// restart — bounce a supervised process the way the LIVE architecture expects:
// process-manager (agent/bin/process-manager.mjs) + launchd, NOT tmux.
// (The previous tmux respawn-pane implementation was dead — there is no tmux
//  in the supervision path; see changelog.md 2026-06-02.)
//
//   ops | chat        → POST the supervisor's own /restart (rotates the inner
//                       claude session, re-reads agents.json; supervisor stays up)
//   whatsapp-channel  → SIGTERM the process-manager child; ManagedProcess
//   wiki-server         respawns it on exit. Confirms a fresh pid comes up.
//   session           → launchctl kickstart -k of ai.claude.session (restarts
//                       process-manager + every child)
function cmdRestart(args) {
  const raw = args.find(a => !a.startsWith('--'));
  if (!raw) die('restart: usage: edva restart <ops|chat|whatsapp-channel|imessage-channel|slack-channel|wiki-server|session>');

  const ALIASES = {
    ops: 'ops', chat: 'chat', session: 'session',
    whatsapp: 'whatsapp-channel', wa: 'whatsapp-channel', 'whatsapp-channel': 'whatsapp-channel',
    imessage: 'imessage-channel', imsg: 'imessage-channel', 'imessage-channel': 'imessage-channel',
    slack: 'slack-channel', 'slack-channel': 'slack-channel',
    wiki: 'wiki-server', 'wiki-server': 'wiki-server',
  };
  const target = ALIASES[raw];
  if (!target) die(`restart: unknown target '${raw}'. Use: ops, chat, whatsapp-channel, imessage-channel, slack-channel, wiki-server, session.`);

  const PM = 'http://127.0.0.1:9095/health';

  // session: restart the whole stack. process-manager is booted by the
  // ai.claude.session LaunchAgent; kickstart -k kills + relaunches it, tearing
  // down and respawning every supervised child.
  if (target === 'session') {
    const uid = process.getuid();
    console.log(c.dim('kickstarting launchd ai.claude.session — restarts process-manager + all supervised children...'));
    const out = shSafe(`launchctl kickstart -k gui/${uid}/ai.claude.session 2>&1`);
    if (out === null) die('restart: launchctl kickstart failed. Try manually: launchctl kickstart -k gui/$(id -u)/ai.claude.session');
    console.log(c.green('✓ kickstart sent. Wait ~30s, then: edva status'));
    return;
  }

  // ops / chat: graceful — the supervisor's own /restart endpoint rotates the
  // inner `claude -p` session (and re-reads agents.json) without killing the
  // supervisor. Documented path: CLAUDE.md § Effort Policy. ops :9093 gates the
  // POST behind a bearer token (secrets/webhook-token); chat :9094 does
  // not — sending the header is harmless either way. The session warm-resumes
  // (same sessionId), so success is verified by restartCount advancing.
  const SUPERVISOR_PORT = { ops: 9093, chat: 9094 };
  if (SUPERVISOR_PORT[target]) {
    const port = SUPERVISOR_PORT[target];
    const before = fetchJson(`http://127.0.0.1:${port}/health`);
    if (!before) {
      die(`restart: ${target} supervisor not reachable on :${port}. Is the stack up? (edva status) — to restart everything: edva restart session`);
    }
    const oldCount = before.restartCount ?? 0;
    const token = readWebhookToken();
    const authArg = token ? `-H "Authorization: Bearer ${token}" ` : '';
    const code = shSafe(`curl -s --max-time 6 -o /dev/null -w "%{http_code}" ${authArg}-X POST http://127.0.0.1:${port}/restart`);
    if (!code || !/^2\d\d$/.test(code.trim())) {
      const hint = code && code.trim() === '401' ? ' (401 unauthorized — missing/stale secrets/webhook-token)' : '';
      die(`restart: POST :${port}/restart returned ${code ? code.trim() : 'no response'}${hint} — check edva logs ${target}-supervisor`);
    }
    console.log(c.dim(`restart requested (HTTP ${code.trim()}) — waiting for the ${target} session to rotate...`));
    let after = null;
    for (let i = 0; i < 20; i++) {
      execFileSync('sleep', ['1']);
      const h = fetchJson(`http://127.0.0.1:${port}/health`);
      if (h && (h.restartCount ?? 0) > oldCount && h.childAlive) { after = h; break; }
    }
    if (!after) {
      console.log(c.yellow(`  ${target}: POST accepted but restartCount didn't advance within 20s — check edva logs ${target}-supervisor`));
      process.exit(1);
    }
    console.log(c.green(`✓ ${target} supervisor restarted`) + c.dim(` (session ${after.sessionId} resumed; restartCount ${oldCount}→${after.restartCount}; agents.json re-read).`));
    return;
  }

  // whatsapp-channel / wiki-server: plain process-manager children with no
  // inner session. SIGTERM the child; process-manager (ManagedProcess) sees the
  // exit (stopping=false → _scheduleRestart) and respawns it.
  const CHILD = {
    'whatsapp-channel': { verify: 'http://127.0.0.1:9100/health', verifyNote: 'paired + listening' },
    'imessage-channel': { verify: 'http://127.0.0.1:9107/health', verifyNote: 'tailing chat.db' },
    'slack-channel':    { verify: 'http://127.0.0.1:9108/health', verifyNote: 'runner up' },
    'wiki-server':      { verify: 'http://127.0.0.1:9096/',       verifyNote: 'serving' },
  };
  const spec = CHILD[target];

  const pm = fetchJson(PM);
  if (!pm) {
    die(`restart: process-manager unreachable on :9095 — it supervises ${target}, so a kill would NOT auto-respawn. Bring the stack up first: edva restart session`);
  }
  const before = (pm.children || []).find((ch) => ch.name === target);
  if (!before) {
    die(`restart: process-manager has no child '${target}' (children: ${(pm.children || []).map((ch) => ch.name).join(', ')})`);
  }
  const oldPid = before.alive ? before.pid : null;

  if (oldPid) {
    console.log(c.dim(`stopping ${target} (pid ${oldPid}) — process-manager will respawn it...`));
    try { process.kill(oldPid, 'SIGTERM'); }
    catch (e) { die(`restart: failed to signal pid ${oldPid}: ${e.message}`); }
  } else {
    console.log(c.yellow(`  ${target} is not currently alive — waiting for process-manager to bring it up...`));
  }

  // Poll process-manager health until a fresh pid is alive (bounded ~25s,
  // covering ManagedProcess restart backoff).
  let fresh = null;
  for (let i = 0; i < 25; i++) {
    execFileSync('sleep', ['1']);
    const h = fetchJson(PM);
    const ch = h && (h.children || []).find((x) => x.name === target);
    if (ch && ch.alive && ch.pid && ch.pid !== oldPid) { fresh = ch; break; }
  }
  if (!fresh) {
    console.log(c.yellow(`  ${target} did not report a new pid within 25s — it may be in restart backoff. Check: edva status ; edva logs ${target}`));
    process.exit(1);
  }

  // Best-effort service-level verification — the process is alive per
  // process-manager, but its HTTP port can take a few seconds to bind, so
  // retry briefly before deciding.
  let note = '';
  if (spec && spec.verify) {
    let ok = false;
    for (let i = 0; i < 8 && !ok; i++) {
      ok = !!shSafe(`curl -sf --max-time 3 -o /dev/null "${spec.verify}" && echo ok`);
      if (!ok) execFileSync('sleep', ['1']);
    }
    note = ok ? c.dim(` (${spec.verifyNote})`) : c.yellow(' — process up but health endpoint not responding yet; may still be starting');
  }
  console.log(c.green(`✓ ${target} restarted — new pid ${fresh.pid}`) + note);
}

// --- arch ---
// The map, then the private halves it points to when present: the personal
// subsystems (architecture-local.md) and the dated history (changelog.md),
// which lived inside architecture.md until 2026-10-24.
function cmdArch() {
  if (!fs.existsSync(ARCH_MD)) die('architecture.md not found');
  process.stdout.write(fs.readFileSync(ARCH_MD, 'utf8'));
  for (const extra of ['architecture-local.md', 'changelog.md']) {
    const p = path.join(SYSTEM, extra);
    if (fs.existsSync(p)) process.stdout.write('\n' + fs.readFileSync(p, 'utf8'));
  }
}

// --- where ---
function cmdWhere(args) {
  const q = args.find(a => !a.startsWith('--'));
  if (!q) die('where: missing <name>');
  const ql = q.toLowerCase();
  const hits = [];
  // tasks
  for (const t of loadTasks()) {
    if (t.name.includes(ql) || t.webhook_task.toLowerCase().includes(ql) || t.phrases.some(p => p.includes(ql)))
      hits.push({ kind: 'task', name: t.name, location: t.trigger_script });
  }
  // services
  for (const s of loadServices()) {
    if ((s.name || '').includes(ql) || (s.label || '').toLowerCase().includes(ql))
      hits.push({ kind: 'service', name: s.name, location: s.plist || s.session || '' });
  }
  // files
  const findOut = shSafe(`find "${TOOLS}" -maxdepth 6 -type f -name "*${q}*" -not -path "*/node_modules/*" -not -path "*/vendor/*" -not -path "*/.git/*" -not -path "*/SourcePackages/*" 2>/dev/null`) || '';
  for (const line of findOut.trim().split('\n').filter(Boolean).slice(0, 20)) {
    hits.push({ kind: 'file', name: path.basename(line), location: line.replace(ROOT + '/', '') });
  }
  if (hasFlag(args, '--json')) { console.log(JSON.stringify(hits, null, 2)); return; }
  if (!hits.length) { console.log(c.yellow('no matches')); process.exit(1); }
  console.log(table(hits, ['kind', 'name', 'location']));
}

// --- doctor ---
function cmdDoctor(args) {
  const checks = [];
  // `warn`: passing but wants a human look. Yellow "!", `warn: true` in --json,
  // never a failure (doctor-preflight-check and the failing-count pings key on `ok`).
  const add = (name, ok, detail, warn = false) => checks.push(warn ? { name, ok, detail, warn: true } : { name, ok, detail });
  const tasks = loadTasks();
  const services = loadServices();

  // 1. cron entries → scripts exist
  const cron = shSafe('crontab -l') || '';
  const cronLines = cron.split('\n').filter(l => l.trim() && !l.startsWith('#'));
  const missingScripts = [];
  for (const line of cronLines) {
    const m = line.match(/(\/Users\/[^\s>]+\.(sh|mjs|js))/);
    if (!m) continue;
    if (!fs.existsSync(m[1])) missingScripts.push(m[1]);
  }
  add('cron → scripts exist', missingScripts.length === 0, missingScripts.length ? `missing: ${missingScripts.join(', ')}` : `${cronLines.length} cron entries, all targets exist`);

  // 2. trigger-*.sh → tasks.json
  const scriptsDir = path.join(TOOLS, 'agent/scripts');
  const triggerScripts = fs.readdirSync(scriptsDir).filter(f => f.startsWith('trigger-') && f.endsWith('.sh'));
  // check-*.sh that hit webhook also count as triggers
  const checkScripts = fs.readdirSync(scriptsDir).filter(f => f.startsWith('check-') && f.endsWith('.sh'));
  const allTriggers = [...triggerScripts, ...checkScripts];
  // Exclude event-driven scripts (not scheduled tasks) from orphan check
  const eventDriven = new Set(['trigger-startup-catchup.sh']);
  const orphans = allTriggers.filter(f => !eventDriven.has(f) && !tasks.some(t => t.trigger_script && t.trigger_script.endsWith(f)));
  add('trigger scripts in tasks.json', orphans.length === 0, orphans.length ? `orphans: ${orphans.join(', ')}` : `${allTriggers.length} trigger scripts, all registered`);

  // A task with paused_until = YYYY-MM-DD (or full ISO) is expected to be
  // absent from crontab until that date. When it passes, the check starts
  // enforcing again — forcing a resume/retire decision. Bare YYYY-MM-DD is
  // anchored to end-of-day in the installation's home zone (instance().tz, the
  // zone the crontab runs in), not UTC midnight, which resumes hours early.
  const nowMs = Date.now();
  const ZONE_OFFSET_FMT = new Intl.DateTimeFormat('en-US', {
    timeZone: instance().tz, timeZoneName: 'shortOffset',
  });
  const pausedUntilMs = (val) => {
    if (!val) return null;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(val)) {
      const ms = Date.parse(val);
      return Number.isFinite(ms) ? ms : null;
    }
    const [y, m, d] = val.split('-').map(Number);
    const nextUtc = Date.UTC(y, m - 1, d + 1);
    const tzPart = ZONE_OFFSET_FMT.formatToParts(new Date(nextUtc)).find(p => p.type === 'timeZoneName')?.value || 'GMT';
    if (tzPart === 'GMT' || tzPart === 'UTC') return nextUtc; // a zone at UTC+0
    const match = tzPart.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/);
    const sign = match?.[1] === '-' ? -1 : 1;
    const hrs = match ? parseInt(match[2], 10) : 0;
    const mins = match?.[3] ? parseInt(match[3], 10) : 0;
    return nextUtc - sign * (hrs * 60 + mins) * 60 * 1000;
  };
  const isPaused = (t) => {
    const until = pausedUntilMs(t.paused_until);
    return until !== null && until > nowMs;
  };
  // `scheduler: "launchd"` tasks are fired by a launchd agent (see services.json +
  // the plist), NOT crontab — cron can't reach the in-session Max keychain. Their
  // plist existence is verified by the services.json check, so skip the cron check.
  const scheduledTasks = tasks.filter(t => t.schedule && t.schedule !== 'on-demand' && t.scheduler !== 'launchd' && !isPaused(t));
  const pausedCount = tasks.filter(t => t.schedule && t.schedule !== 'on-demand' && t.scheduler !== 'launchd' && isPaused(t)).length;
  // Clock-anchored jobs (data/clock-jobs.json) have their crontab
  // MM/HH/DOW fields intentionally rewritten nightly by cron-tz-sync to match
  // the user's actual local time — so their live crontab entry legitimately
  // diverges from tasks.json's nominal `schedule` field whenever the user is outside
  // the instance's home zone. Match by label (= trigger_script basename minus .sh,
  // the same key cron-tz-sync matches on) and compare against the
  // currently-expected home-zone time instead of the literal tasks.json field.
  const { loadClockJobs, resolveTz, localToHomeZone } = require(path.join(TOOLS, 'lib/clock-jobs.js'));
  const clockJobList = loadClockJobs();
  const clockJobsByLabel = new Map(clockJobList.map(j => [j.label, j]));
  let clockTz = null;
  const unscheduled = [];
  for (const t of scheduledTasks) {
    // A cron-run-direct task (trigger_script: null, since 2026-10-10) is found by
    // its `--label <name>`; path.basename(null) threw and took doctor down.
    // A task whose cron line runs something OTHER than its trigger_script names
    // that line's label in `cron_label` (2026-10-20): daily-summary-fix's trigger
    // is launched by launchd off its queue directory, and its one cron line is the
    // hourly `daily-summary-fix sweep`, labelled daily-summary-fix-sweep, so the
    // trigger's basename is in no crontab line and doctor read the healthy sweep
    // as "missing cron". Explicit, like clock-jobs.json's "task" field, never a
    // label prefix; the trailing space stops a label matching a longer one.
    const want = t.cron_label ? `--label ${t.cron_label} `
      : t.trigger_script ? path.basename(t.trigger_script) : `--label ${t.name} `;
    const base = t.cron_label || want.replace(/\.sh$/, '');
    // One clock job keyed by the task's own label, or several when one script
    // runs at more than one local time with a label per cron line, which
    // clock-jobs.json ties back to the task by name ("task": "hum-explore" on
    // trigger-hum-explore-midday and -evening). Before 2026-10-13 that second
    // shape fell through to the literal tasks.json schedule and read as
    // "missing cron". Matched explicitly, never by label prefix: trigger-hum
    // is a prefix of trigger-hum-explore-midday.
    const clockJobs = clockJobsByLabel.has(base)
      ? [clockJobsByLabel.get(base)]
      : clockJobList.filter(j => j.task === t.name);
    let schedParts;
    if (clockJobs.length) {
      if (clockTz === null) clockTz = resolveTz().tz;
      schedParts = clockJobs.map((j) => {
        const { hour, minute, dow } = localToHomeZone(clockTz, j.local_time, j.dow);
        return `${Number(minute)} ${Number(hour)} * * ${j.dow != null ? dow : '*'}`;
      });
    } else {
      // Multi-schedule separator is " / " (space-slash-space). Require
      // whitespace on both sides so we don't split on the step-value "/"
      // inside "*/20 * * * *" etc.
      schedParts = t.schedule.split(/\s+\/\s+/).map(s => s.trim()).filter(Boolean);
    }
    const found = schedParts.every(sched => cronLines.some(l => l.includes(want) && l.startsWith(sched)));
    if (!found) unscheduled.push(clockJobs.length ? `${t.name} (tz-adjusted)` : t.name);
  }
  const pausedSuffix = pausedCount ? `, ${pausedCount} paused` : '';
  const tzSuffix = clockTz && clockTz !== instance().tz ? ` (${clockJobsByLabel.size} clock-anchored, tz=${clockTz})` : '';
  add('tasks.json schedules ↔ crontab', unscheduled.length === 0, unscheduled.length ? `missing cron: ${unscheduled.join(', ')}` : `${scheduledTasks.length} scheduled tasks, all in cron${pausedSuffix}${tzSuffix}`);

  // 4. ops_playbook_section headers exist
  const opsMd = fs.existsSync(OPS_CLAUDE) ? fs.readFileSync(OPS_CLAUDE, 'utf8') : '';
  const missingSections = tasks.filter(t => t.ops_playbook_section && !t.job && !new RegExp(`^## ${escRe(t.ops_playbook_section)}( \\(.*\\))?\\s*$`, 'm').test(opsMd)).map(t => `${t.name} → ${t.ops_playbook_section}`);
  add('ops playbook sections exist', missingSections.length === 0, missingSections.length ? `missing: ${missingSections.join('; ')}` : `${tasks.length} sections verified in ops-agent/CLAUDE.md`);

  // 5. services.json plists → exist
  const missingPlists = [];
  for (const s of services) {
    if (s.type !== 'launchagent') continue;
    const p = expandHome(s.plist);
    if (!fs.existsSync(p)) missingPlists.push(s.label);
  }
  add('services.json plists exist', missingPlists.length === 0, missingPlists.length ? `missing: ${missingPlists.join(', ')}` : `${services.filter(s => s.type === 'launchagent').length} plists verified`);

  // 6. no old Dev/Tools paths in tracked text files
  // Use git grep — it natively skips binary files and respects .gitignore.
  // Exclude files that legitimately contain the pattern (this tool + its test harness).
  const grepOut = shSafe(`git grep -l -E "${HOME}/Dev/Tools/|~/Dev/Tools/|\\$HOME/Dev/Tools/" -- ":!*.png" ":!*.jpg" ":!*.pdf" ":!*.p8" ":!*.provisionprofile" ":!bin/edva" ":!system/test-edva.sh" ":!system/architecture.md" ":!system/changelog.md" || true`, { cwd: ROOT }) || '';
  const badPaths = grepOut.split('\n').filter(Boolean);
  add('no Dev/Tools/ residuals in tracked files', badPaths.length === 0,
      badPaths.length ? `found in: ${badPaths.slice(0, 5).join(', ')}${badPaths.length > 5 ? ` (+${badPaths.length-5})` : ''}` : 'clean');

  // 7. phrase uniqueness
  const phraseMap = new Map();
  for (const t of tasks) for (const p of t.phrases) {
    const k = p.toLowerCase();
    if (!phraseMap.has(k)) phraseMap.set(k, []);
    phraseMap.get(k).push(t.name);
  }
  const dupes = [...phraseMap.entries()].filter(([_, v]) => v.length > 1);
  add('task phrases are unique', dupes.length === 0, dupes.length ? `shared: ${dupes.map(([p, ts]) => `"${p}" in [${ts.join(',')}]`).join('; ')}` : `${phraseMap.size} unique phrases`);

  // 8. trigger_script paths exist (skip tasks with null trigger_script — those are on-demand dispatch-only entries)
  const missingTrigs = tasks.filter(t => t.trigger_script && !fs.existsSync(path.join(ROOT, t.trigger_script))).map(t => t.name);
  add('trigger_script paths exist', missingTrigs.length === 0, missingTrigs.length ? `missing: ${missingTrigs.join(', ')}` : `${tasks.filter(t => t.trigger_script).length} trigger scripts verified`);

  // 8b. trigger scripts are executable. cron-run spawns the script directly (not
  // `bash script`), so a script lacking the +x bit fails with EACCES/exit 127 and
  // the job silently never runs while every wiring check above still passes
  // (a 3-day job outage: a set of per-platform scripts shipped
  // -rw-r--r-- and failed for 3 days, undetected).
  const notExec = tasks
    .filter(t => t.trigger_script && fs.existsSync(path.join(ROOT, t.trigger_script)))
    .filter(t => { try { return !(fs.statSync(path.join(ROOT, t.trigger_script)).mode & 0o100); } catch { return false; } })
    .map(t => t.name);
  add('trigger scripts executable', notExec.length === 0, notExec.length ? `NOT executable (cron-run → EACCES/127): ${notExec.join(', ')} — chmod +x` : `${tasks.filter(t => t.trigger_script).length} trigger scripts +x`);

  // 8c. recent cron-run outcomes. The wiring checks pass even when a job RUNS and
  // FAILS — only the `cron-runs.jsonl` ledger knows. We flag the high-signal
  // "could not execute at all" band — exit 126 (not executable) / 127 (spawn
  // ENOENT/EACCES, bad shebang/interpreter, command-not-found) — for any label
  // whose most-recent run within 48h is in that band. This is exactly the
  // EACCES outage class above, with no false positives. We do NOT
  // flag generic non-zero (exit 1): it's ambiguous — edva-sync/skills-sync
  // exit 1 by design (divergence/dirty-tree), conditional reminders exit 1 when
  // their condition isn't met. Those need per-job logic, not a blanket gate.
  try {
    const raw = fs.readFileSync(path.join(ROOT, 'data/cron-runs.jsonl'), 'utf8').trim().split('\n').filter(Boolean);
    const cutoff = Date.now() - 48 * 3600 * 1000;
    const latest = new Map();
    for (const line of raw) { try { const r = JSON.parse(line); if (r.label && r.start) latest.set(r.label, r); } catch {} }
    const failing = [...latest.values()]
      .filter(r => new Date(r.start).getTime() >= cutoff && (r.exit === 126 || r.exit === 127))
      .map(r => `${r.label}(exit ${r.exit})`);
    add('recent cron runs executable', failing.length === 0, failing.length ? `couldn't execute (126/127) in last 48h: ${failing.join('; ')} — chmod +x / fix interpreter PATH` : `${latest.size} labels, no exec failures`);
  } catch (e) { if (e.code !== 'ENOENT') add('recent cron runs executable', false, `cron-runs.jsonl read failed: ${e.message}`); }

  // 8d. trigger scripts have a valid shebang. cron-run spawns scripts directly via
  // execve, which requires the file to begin with the exact bytes "#!". A script
  // that is +x but whose first line is malformed (e.g. "#\!/bin/bash" — a stray
  // backslash from an echo/printf !-escape) throws ENOEXEC at spawn time; cron-run
  // then crashes BEFORE writing a cron-runs.jsonl entry, so the 126/127 ledger
  // check (8c) never even sees it — only a static scan catches this class.
  // (db-retention shipped #\!/bin/bash on 2026-06-08 and silently never ran until
  // 2026-06-24.) Scan every .sh cron-run executes directly: tasks.json triggers +
  // any `… -- /Users/…/x.sh` target in the crontab (skips `-- bash -c '…'` lines).
  const directShTargets = new Set();
  for (const t of tasks) if (t.trigger_script && t.trigger_script.endsWith('.sh')) directShTargets.add(path.join(ROOT, t.trigger_script));
  for (const line of cronLines) {
    const after = line.split(/\s--\s/)[1];
    const m = after && after.match(/^(\/Users\/\S+\.sh)\b/);
    if (m) directShTargets.add(m[1]);
  }
  const badShebang = [];
  for (const p of directShTargets) {
    try {
      const fd = fs.openSync(p, 'r'); const buf = Buffer.alloc(2);
      const n = fs.readSync(fd, buf, 0, 2, 0); fs.closeSync(fd);
      if (n < 2 || buf[0] !== 0x23 || buf[1] !== 0x21) badShebang.push(path.basename(p)); // not "#!"
    } catch {}
  }
  add('trigger scripts have valid shebang', badShebang.length === 0, badShebang.length ? `bad shebang (execve→ENOEXEC, no ledger entry): ${badShebang.join(', ')} — first two bytes must be "#!"` : `${directShTargets.size} direct cron scripts, all shebangs valid`);

  // 8d2. cron-exec'd scripts have a RESOLVABLE interpreter. (8d) proves a file
  // starts with "#!"; it does not prove the interpreter named there exists on
  // cron's PATH. `#!/usr/bin/env node` is a perfectly VALID shebang that still
  // dies with exit 127 under cron, because cron runs with a bare compiled-in
  // PATH (/usr/bin:/bin — verified 2026-08-05: no PATH= line in the crontab,
  // and the failure text was literally "env: node: No such file or directory")
  // while Homebrew's node lives in /opt/homebrew/bin.
  //
  // Neither existing check catches this class:
  //   - (8c) is ledger-based, so it only sees a job AFTER it has already failed,
  //     and only for jobs run through `cron-run --label` — 31 of 123 entries
  //     bypass cron-run entirely, and those never reach cron-runs.jsonl at all.
  //   - (8d) only scans *.sh targets. Both real instances were EXTENSIONLESS
  //     node scripts, so it never looked at them.
  // calendar-attendee-audit failed silently every night until 2026-08-05, and
  // hum-channel-audit carried the same shebang while firing once a year
  // (0 8 23 6 *) with no --label — a 12-month-invisible breakage. Only a static
  // scan closes this, which is why it is a sibling of (8d) rather than (8c).
  //
  // A shebang only matters when the script is exec'd DIRECTLY. Most Homebrew-node
  // scripts under cron are safe precisely because their crontab line names
  // /opt/homebrew/bin/node explicitly and the shebang is never consulted — so a
  // token preceded by an interpreter (or by a redirect) is skipped, not flagged.
  // Logic lives in lib/cron-interpreter-check.js so it is unit-testable
  // (agent/test/cron-interpreter-check.test.mjs covers both real
  // regressions plus the safe-by-explicit-interpreter case).
  const { findUnresolvableInterpreters } = require(path.join(ROOT, 'lib/cron-interpreter-check.js'));
  const { bad: unresolvable, scanned: execScanned } = findUnresolvableInterpreters(cronLines);
  add("cron-exec'd scripts have a resolvable interpreter", unresolvable.length === 0,
    unresolvable.length
      // An `env node` script under cron-run stays red (the wrapper is deliberately
      // not trusted) but is not said to exit 127 now: it runs while cron-run puts
      // node on PATH (lib/cron-interpreter-check.js, BUT SAY WHICH).
      ? `interpreter not on cron's bare PATH: ${unresolvable.map(b => `${b.file} (${b.shebang}${b.wrapperRescued ? '; runs only while cron-run puts node on PATH, exit 127 without it' : ' → exit 127'})`).join('; ')} — hardcode the absolute interpreter path (e.g. #!/opt/homebrew/bin/node)`
      : `${execScanned.length} directly-exec'd cron scripts, all interpreters resolve`);

  // 8d3. is every ACTIVE crontab entry still a well-formed schedule + command?
  //
  // Sibling of (8d2), and a static scan for the same reason: the failure never
  // reaches the ledger, because a job that cannot run produces no row to fail.
  //
  // On 2026-09-05T04:05Z cron-tz-sync matched a DISABLED entry by its --label
  // and rewrote it positionally, overwriting the `#HUMPAUSE#` marker with the
  // minute and shifting every remaining field one place right:
  //     #HUMPAUSE# 0 23 * * * /…/cron-run --label trigger-hum-daily -- …
  //  →  0 23 23 * * *        /…/cron-run --label trigger-hum-daily -- …
  // Six fields: cron reads `0 23 23 * *` as the schedule (23:00 on the 23rd)
  // and the bare `*` as the command, which cannot run. The pause marker is
  // gone too, so lifting the pause restores every OTHER lane and leaves this
  // one dead. cron-tz-sync's own guards (added the same day) stop it happening
  // again; they do not repair a line already damaged, and nothing else looked.
  // (8c) is ledger-based and sees no failure; (8d)/(8d2) resolve the command's
  // script and interpreter, and `*` is neither.
  //
  // The discriminator is that a schedule field is glyphs only while a command
  // always contains a letter — zero false positives across all 238 lines of
  // the live crontab. Logic lives in lib/cron-wellformed-check.js so it
  // is unit-testable (agent/test/cron-wellformed-check.test.mjs covers
  // the real regression plus the legal shapes that must stay green).
  const { findMalformedCronEntries, describeMalformed } = require(path.join(ROOT, 'lib/cron-wellformed-check.js'));
  const { bad: malformed, scanned: wellformedScanned } = findMalformedCronEntries(cronLines);
  add('crontab entries are well-formed', malformed.length === 0,
    malformed.length
      ? `unrunnable cron entr${malformed.length === 1 ? 'y' : 'ies'} — ${describeMalformed(malformed)}. Repair the line by hand; a shifted schedule also means a pause marker was overwritten.`
      : `${wellformedScanned} active cron entries, all schedule/command boundaries intact`);

  // 8f. is the shared clone actually committable right now?
  //
  // `edva-commit` is the only sanctioned write path and it can be blocked by
  // conditions that belong to nobody in particular: an unmerged path left by a
  // stash pop makes its plain `git commit` refuse for EVERY caller, and a file
  // another session left staged trips its foreign-file guard (exit 3). Both are
  // invisible until something tries to commit — and the thing that tries is
  // usually self-improve-approval-poll landing a card the user has already signed,
  // which records status "applied" whether or not the commit half succeeded.
  // Logic lives in lib/repo-committable-check.js so it is unit-testable.
  try {
    const { findCommitBlockers, describeBlockers } = require(path.join(ROOT, 'lib/repo-committable-check.js'));
    const gitRun = (a) => execFileSync('git', a, { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    const { ok: committable, blockers } = findCommitBlockers(gitRun);
    add('repo is committable', committable,
      committable
        ? 'no unmerged paths, no conflict markers, nothing left staged'
        : describeBlockers(blockers));
  } catch (e) {
    // Deliberately FAILS rather than degrading to green. This check exists
    // because a blocked commit already reports success everywhere else in the
    // pipeline; a version of it that answered "fine" whenever it could not run
    // would reproduce the exact bug class it was written to catch.
    add('repo is committable', false, `could not determine — ${e.message.split('\n')[0]}`);
  }

  // 8e. sustained cron-run failures. (8c) only flags the 126/127 "could not execute"
  // band because a single non-zero exit is ambiguous (edva-sync/skills-sync exit 1
  // by design on divergence/dirty-tree; conditional reminders exit 1 until their
  // condition is met). But a job whose newest run failed AND has failed every run for
  // a sustained streak is unambiguously stuck — that's how skills-sync sat blocked 37×
  // overnight 2026-06-24 while every other check stayed green. Flag a label whose
  // newest run is non-zero with a consecutive-failure streak ≥ 3 (within 48h), excluding
  // the 126/127 band (8c owns it) and ad-hoc one-shot reminders (UPPERCASE_…_<date>
  // labels that exit 1 by design while polling for a condition).
  try {
    const raw = fs.readFileSync(path.join(ROOT, 'data/cron-runs.jsonl'), 'utf8').trim().split('\n').filter(Boolean);
    const cutoff = Date.now() - 48 * 3600 * 1000;
    const byLabel = new Map();
    for (const line of raw) {
      try {
        const r = JSON.parse(line);
        if (r.label && r.start && new Date(r.start).getTime() >= cutoff) {
          if (!byLabel.has(r.label)) byLabel.set(r.label, []);
          byLabel.get(r.label).push(r);
        }
      } catch {}
    }
    const adHoc = /^[A-Z][A-Z0-9_]*_\d{6,}$/;
    const stuck = [];
    for (const [label, runs] of byLabel) {
      if (adHoc.test(label)) continue;
      let streak = 0; // walk newest→oldest; count consecutive non-zero (non-exec-band) exits
      for (let i = runs.length - 1; i >= 0; i--) {
        const ex = runs[i].exit;
        if (ex === 0 || ex === 126 || ex === 127) break;
        streak++;
      }
      if (streak >= 3) stuck.push(`${label}(${streak}× fail, last exit ${runs[runs.length - 1].exit})`);
    }
    add('cron runs not stuck-failing', stuck.length === 0, stuck.length ? `sustained failures (≥3 in a row, last 48h): ${stuck.join('; ')}` : `no label failing ≥3× in a row`);
  } catch (e) { if (e.code !== 'ENOENT') add('cron runs not stuck-failing', false, `cron-runs.jsonl read failed: ${e.message}`); }

  // 9. process-manager running (check HTTP health endpoint — pgrep can't see cross-session processes on macOS)
  const pmHealth = shSafe('curl -sf --max-time 3 http://127.0.0.1:9095/health');
  add('process-manager running', !!pmHealth, pmHealth ? 'HTTP 200' : 'unreachable on :9095 — check launchd');

  // 10. supervisor health endpoints reachable
  const chatHealth = fetchJson('http://127.0.0.1:9094/health');
  add('chat supervisor reachable', !!chatHealth, chatHealth ? 'HTTP 200' : 'unreachable on :9094');
  const opsHealth = fetchJson('http://127.0.0.1:9093/health');
  add('ops supervisor reachable', !!opsHealth, opsHealth ? 'HTTP 200' : 'unreachable on :9093');

  // 10b. WhatsApp channel reachable + paired. Runs as the 5th process-manager
  // child (Baileys gateway). If the process is up but unpaired, the host_jid
  // field is null and we need to re-run the pair flow.
  const waHealth = fetchJson('http://127.0.0.1:9100/health');
  const waPaired = waHealth && waHealth.host_jid;
  add('whatsapp-channel reachable + paired', !!waPaired,
    waPaired
      ? `paired as ${waHealth.host_jid} (${waHealth.host_name || 'unknown'})`
      : waHealth
        ? 'up but unpaired — wa-auth missing or session revoked; re-pair via `npm run pair -- --phone <E164>` in agent/whatsapp-channel'
        : 'unreachable on :9100 — process-manager should be supervising it; check whatsapp-channel.log');

  // 11. MCP configs are valid JSON
  for (const name of ['chat-mcp-config.json', 'mcp-config.json']) {
    const p = path.join(TOOLS, 'agent/supervisor', name);
    let valid = false;
    try { JSON.parse(fs.readFileSync(p, 'utf8')); valid = true; } catch {}
    add(`${name} valid`, valid, valid ? 'valid JSON' : 'missing or invalid');
  }

  // 12. CLAUDE.md freshness — each agent's CLAUDE.md shouldn't be newer than
  // its current session. The supervisor exposes sessionStartedAt (set on each
  // startSession call including graceful restarts) — prefer that over the
  // supervisor-process startedAt so graceful restarts clear the STALE state.
  // Very recent edits (< CLAUDE_MD_GRACE_MIN) are treated as "pending restart"
  // rather than STALE: they're an active-editing state, not a stale-config
  // running-in-production state. True operational staleness means the file
  // was changed long ago and the supervisor was never bounced to pick it up.
  const CLAUDE_MD_GRACE_MIN = 10;
  for (const [name, port, relPath] of [
    ['chat', 9094, 'agent/chat-agent/CLAUDE.md'],
    ['ops', 9093, 'agent/ops-agent/CLAUDE.md'],
  ]) {
    const cmdPath = path.join(TOOLS, relPath);
    let ok = false;
    let status = null;
    try {
      const health = fetchJson(`http://127.0.0.1:${port}/health`) || {};
      const sessionTs = health.sessionStartedAt || health.startedAt;
      const ref = sessionTs ? new Date(sessionTs).getTime() : 0;
      const mtime = fs.statSync(cmdPath).mtimeMs;
      const ageMin = (Date.now() - mtime) / 60000;
      if (!ref) { ok = false; status = 'supervisor unreachable'; }
      else if (mtime <= ref) { ok = true; status = 'fresh'; }
      else if (ageMin < CLAUDE_MD_GRACE_MIN) {
        ok = true;
        status = `fresh (edited ${ageMin.toFixed(0)}min ago — within ${CLAUDE_MD_GRACE_MIN}min grace, pending restart)`;
      } else {
        ok = false;
        status = `STALE — CLAUDE.md edited ${ageMin.toFixed(0)}min ago, session started ${new Date(ref).toISOString()}`;
      }
    } catch (err) { ok = false; status = `check failed: ${err.message}`; }
    add(`${name} CLAUDE.md fresh`, ok, status);
  }

  // 13. hum liveness — hum fires 5x/day at 10:30, 12:30, 15:30, 17:30, 22:30 local.
  // Longest natural gap inside waking hours is ~5h (17:30 → 22:30) + jitter, so 7h stale is broken.
  // Check only inside 11:00-22:59 local to avoid false positives during overnight sleep window.
  const humRunsPath = path.join(TOOLS, 'data/hum-runs.jsonl');
  const hour = new Date().getHours();
  const inWakingCheck = hour >= 11 && hour < 23;
  if (!inWakingCheck) {
    add('hum liveness', true, `skipped (outside 11:00–23:00 check window, now ${hour}:00)`);
  } else {
    let raw = null;
    try { raw = fs.readFileSync(humRunsPath, 'utf8'); }
    catch (e) { if (e.code !== 'ENOENT') add('hum liveness', false, `read failed: ${e.message}`); }
    if (raw !== null) {
      const lines = raw.split('\n').filter(Boolean);
      let lastTs = null;
      for (let i = lines.length - 1; i >= 0; i--) {
        try { const r = JSON.parse(lines[i]); if (r.ts) { lastTs = r.ts; break; } } catch {}
      }
      if (!lastTs) {
        add('hum liveness', true, 'no runs yet (fresh install)');
      } else {
        const ageH = (Date.now() - new Date(lastTs).getTime()) / 3600000;
        const stale = ageH > 7;
        add('hum liveness', !stale, stale
          ? `STALE — last run ${ageH.toFixed(1)}h ago; expect a run every ~2h during waking hours`
          : `last run ${ageH.toFixed(1)}h ago (${new Date(lastTs).toLocaleString()})`);
      }
    } else if (raw === null && !checks.some(c => c.name === 'hum liveness')) {
      add('hum liveness', true, 'hum not installed (no hum-runs.jsonl)');
    }
  }

  // 14. Chrome DevTools Protocol reachable (port 9222).
  // The ops-agent's chrome-devtools MCP uses --autoConnect, which requires
  // Chrome to be running with --remote-debugging-port enabled on a non-default
  // user data directory. Without CDP reachable, any mcp__chrome-devtools__*
  // tool call hangs until the supervisor's 10-min TURN WATCHDOG trips.
  // Detecting this up-front in doctor surfaces the state anytime the user
  // runs it; the chrome-cdp-watch cron owns transition-triggered alerting.
  // Probe uses `localhost` (not 127.0.0.1): Chrome 147 silently binds an IPv4
  // stub on :9222 from the user's interactive profile that 404s on every CDP
  // path. `localhost` resolves to ::1 first on macOS and hits the LaunchAgent
  // automation Chrome (com.edva.chrome-cdp) which binds IPv6 :9222.
  const cdpProbe = shSafe('curl -s --max-time 5 -o /dev/null -w "%{http_code}" http://localhost:9222/json/version 2>/dev/null') || '000';
  const cdpUp = cdpProbe === '200';
  add('chrome CDP port reachable', cdpUp, cdpUp
    ? 'HTTP 200 on :9222/json/version'
    : `HTTP ${cdpProbe} on :9222 — automation Chrome not running. Check LaunchAgent: launchctl list | grep com.edva.chrome-cdp. Browser-automation jobs will skip until this clears.`);

  // 15. gog tasks CLI reachable. The 2026-04-29 review documented memories
  // #914/#920 falsely flagging "gog CLI unavailable" because the symlink
  // target was inspected instead of the actual binary. Probe by invoking a
  // no-op subcommand: a non-zero exit surfaces real auth/binary regressions
  // (renamed binary, expired token bucket) without reading the symlink.
  const gogProbe = shSafe(`/opt/homebrew/bin/gog tasks lists --plain ${OWNER_EMAIL ? `--account=${OWNER_EMAIL} ` : ''}--no-input 2>&1 | head -3`);
  const gogOk = gogProbe && !/no auth|missing|not found|error/i.test(gogProbe);
  add('gog tasks CLI reachable', !!gogOk, gogOk
    ? `lists fetched (${gogProbe.split('\n').filter(Boolean).length} rows)`
    : `gog tasks list failed: ${(gogProbe || '<empty>').slice(0, 160)}. Re-auth via 'gog auth add ${OWNER_EMAIL || '<your-account>'} --services tasks' or fall back to service account.`);

  // 16. CI keychain-lock fleet in sync. Every macOS-signing repo on this host
  // mutates ONE global user keychain search list. When that goes wrong the
  // symptom is not a build failure — it is login.keychain-db being evicted,
  // which takes Edva's Max auth down with "Not logged in" and no API-key
  // fallback. A defect like this gets copy-pasted across workflows and repos,
  // so the expensive part is DISCOVERY, not the fix; this check re-runs that
  // audit continuously. Skipped, not failed, when gh is missing or
  // unauthenticated (exit 2) — doctor runs on hosts without gh, and a network
  // hiccup must not read as fleet drift.
  const kcAudit = installTools("bin/ci-keychain-lock-audit");
  if (fs.existsSync(kcAudit)) {
    const kcOut = shSafe(`${kcAudit} 2>&1; echo "EXIT:$?"`) || 'EXIT:2';
    const kcCode = (kcOut.match(/EXIT:(\d+)\s*$/) || [, '2'])[1];
    if (kcCode === '2') {
      add('CI keychain-lock fleet in sync', true, 'skipped (gh unavailable/unauthenticated)');
    } else if (kcCode === '0') {
      add('CI keychain-lock fleet in sync', true, 'all signing repos byte-identical + sourcing the helper');
    } else {
      const bad = kcOut.split('\n').filter(l => /FAIL/.test(l))
        .map(l => l.trim().replace(/\s+/g, ' ')).slice(0, 4).join('; ');
      add('CI keychain-lock fleet in sync', false,
        `${bad || 'drift detected'}. Run bin/ci-keychain-lock-audit for the full list; re-vendor with 'cp .github/scripts/ci-keychain-lock.sh <repo>/.github/scripts/'. A repo that stops sourcing the helper can evict login.keychain-db and take Max auth down.`);
    }
  }

  // 17. one Claude Code on a job's PATH — WARN-level: a latent hazard once no call
  // site runs a bare `claude`; red would sit in every pre-flight log. No spawn, no network.
  // Logic: lib/claude-binaries.js (tests/claude-binaries.test.mjs).
  try {
    const { findClaudeBinaries, describeClaudeBinaries } = require(path.join(__dirname, '../lib/claude-binaries.js'));
    const { warn, detail } = describeClaudeBinaries(findClaudeBinaries({ homedir: HOME }), { homedir: HOME });
    add("one Claude Code on a job's PATH", true, detail, warn);
  } catch (e) {
    add("one Claude Code on a job's PATH", true, `could not determine — ${e.message.split('\n')[0]}`, true);
  }

  // 18 + 19. Landed but not live; code left uncommitted — WARN-level.
  // A daemon runs the code it started with (one landed fix sat inert in hum-sense
  // for a week), and an uncommitted edit lives only in the working tree, where a revert or a
  // failed autostash undoes it (2026-10-10). Read-only: supervisor-code-reload --report.
  const scr = shSafe(`"${process.execPath}" "${path.join(__dirname, 'supervisor-code-reload')}" --report`, { timeout: 60_000 });
  let rep = null;
  try { rep = scr ? JSON.parse(scr) : null; } catch {}
  if (!rep || !rep.ok) {
    add('running code matches what landed', true, 'could not determine — supervisor-code-reload --report gave no answer', true);
  } else {
    const hour = 3_600_000;
    const sups = rep.supervisors.filter((s) => s.stale_since && Date.now() - Date.parse(s.stale_since) > hour);
    const late = [
      ...rep.late.map((l) => `${l.name} (pid ${l.pid}, up since ${l.started.slice(0, 16)}Z, missing code committed from ${l.since.slice(0, 16)}Z on, newest ${l.newest}; ${l.fix})`),
      ...sups.map((s) => `${s.agent} supervisor (stale since ${s.stale_since.slice(0, 16)}Z${s.held ? `, reload held: ${s.held}` : ''}; edva restart session)`),
    ];
    add('running code matches what landed', true, late.length
      ? `landed but not live: ${late.join('; ')}`
      : `${rep.running} of ${rep.watched} watched daemons running, each on the code that landed; supervisors current (supervisor-code-reload)`, late.length > 0);
    if (rep.uncommitted) {
      const old = rep.uncommitted.code.filter((a) => a.hours > 24);
      const dataOld = rep.uncommitted.data.filter((a) => a.hours > 24).length;
      add('no code file uncommitted over 24h', true, (old.length
        ? `${old.length} code file(s) modified but not committed for over a day; a revert or failed sync would silently undo them: ${old.map((a) => `${a.path} (since ${a.since.slice(0, 16)}Z)`).join(', ')}. Commit each with edva-commit -m "..." -- <path>.`
        : `${rep.uncommitted.code.length} code file(s) modified, none known to be over a day.`)
        + ` Runtime data (data/, not warned): ${rep.uncommitted.data.length} modified, ${dataOld} over a day.`, old.length > 0);
    }
  }

  if (hasFlag(args, '--json')) { console.log(JSON.stringify(checks, null, 2)); process.exit(checks.every(c => c.ok) ? 0 : 1); }

  // --repair: auto-fix repairable drift (schedule mismatches + orphan scripts in cron)
  if (hasFlag(args, '--repair')) {
    const mutableTasks = loadTasks();
    let repaired = 0;

    // Build cron map: triggerBasename -> [schedule strings]
    const cronMapR = {};
    for (const line of cronLines) {
      const scriptMatch = line.match(/trigger-[\w-]+\.sh/);
      if (!scriptMatch) continue;
      const bname = scriptMatch[0];
      const parts = line.trim().split(/\s+/);
      const sched = parts.slice(0, 5).join(' ');
      if (!cronMapR[bname]) cronMapR[bname] = [];
      cronMapR[bname].push(sched);
    }

    // Fix schedule mismatches
    for (const t of mutableTasks) {
      if (!t.trigger_script || !t.schedule || t.schedule === 'on-demand') continue;
      const bname = t.trigger_script.split('/').pop();
      const actual = cronMapR[bname];
      if (!actual) continue;
      const taskParts = t.schedule.split(/\s+\/\s+/).map(s => s.trim()).sort();
      const actualParts = actual.slice().sort();
      if (JSON.stringify(taskParts) !== JSON.stringify(actualParts)) {
        const newSched = actual.length === 1 ? actual[0] : actual.join(' / ');
        console.log(`  repair: ${t.name} schedule "${t.schedule}" → "${newSched}"`);
        t.schedule = newSched;
        repaired++;
      }
    }

    // Register orphan scripts (in cron, not in tasks.json)
    const taskScriptsR = new Set(mutableTasks.map(t => t.trigger_script && t.trigger_script.split('/').pop()).filter(Boolean));
    for (const [bname, scheds] of Object.entries(cronMapR)) {
      if (taskScriptsR.has(bname)) continue;
      const scriptPath = path.join(TOOLS, 'agent/scripts', bname);
      if (!fs.existsSync(scriptPath)) continue;
      // Read the first comment line for a description
      let desc = '';
      try { const lines = fs.readFileSync(scriptPath, 'utf8').split('\n'); for (const l of lines) { const m = l.match(/^#\s*(.+)/); if (m && !m[1].startsWith('!')) { desc = m[1].trim(); break; } } } catch {}
      const taskName = bname.replace(/^trigger-/, '').replace(/\.sh$/, '');
      const newSched = scheds.length === 1 ? scheds[0] : scheds.join(' / ');
      const entry = {
        name: taskName,
        schedule: newSched,
        schedule_human: newSched,
        trigger_script: `agent/scripts/${bname}`,
        webhook_url: 'http://localhost:9092',
        webhook_task: taskName.toUpperCase().replace(/-/g, ' '),
        ops_playbook_section: null,
        delivers_to: 'unknown',
        phrases: [],
        description: desc || `Auto-registered by doctor --repair on ${new Date().toISOString().slice(0,10)}.`,
        job: taskName,
      };
      console.log(`  repair: registered orphan ${taskName} @ ${newSched}`);
      mutableTasks.push(entry);
      repaired++;
    }

    if (repaired > 0) {
      writeTasks(mutableTasks);
      console.log(c.green(`\n  ${repaired} repair(s) applied to agent/local/tasks.json. Run 'edva doctor' to verify.`));
    } else {
      console.log(c.dim('  nothing to repair'));
    }
    process.exit(0);
  }

  let failed = 0, warned = 0;
  for (const ck of checks) {
    const mark = !ck.ok ? c.red('✗') : ck.warn ? c.yellow('!') : c.green('✓');
    console.log(`${mark} ${c.bold(ck.name)}`);
    console.log(`  ${c.dim(ck.detail)}`);
    if (!ck.ok) failed++;
    else if (ck.warn) warned++;
  }
  console.log('');
  const warnSuffix = warned ? c.yellow(` (${warned} warning${warned === 1 ? '' : 's'})`) : '';
  if (failed === 0) console.log(c.green(`${checks.length}/${checks.length} checks passed`) + warnSuffix);
  else { console.log(c.red(`${failed}/${checks.length} checks FAILED`) + warnSuffix); process.exit(1); }
}

function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

// --- hum ---
const HUM_STATE   = path.join(TOOLS, 'data/hum-state.json');
const HUM_SEEN    = path.join(TOOLS, 'data/hum-seen.json');
const HUM_FEEDBK  = path.join(TOOLS, 'data/hum-feedback.jsonl');
const HUM_RUNS    = path.join(TOOLS, 'data/hum-runs.jsonl');
const HUM_REACTION_ALIASES = {
  '👍':'helpful', 'helpful':'helpful', 'good':'helpful', 'yes':'helpful',
  '👎':'skip', 'skip':'skip', 'bad':'skip', 'no':'skip',
  '💤':'snooze', 'snooze':'snooze',
  'more':'more', 'more_of_these':'more', 'more of these':'more',
  // iOS tapback tokens (phone-channel forwards these raw from
  // edva_messages.reaction). Match the semantic intent the client exposes
  // (Great / Useful / Not Useful) to the existing hum vocabulary.
  '❤️':'more', 'heart':'more',
  'thumbs_up':'helpful',
  'thumbs_down':'skip',
};

function loadHumState() {
  try { return JSON.parse(fs.readFileSync(HUM_STATE, 'utf8')); }
  catch (e) {
    if (e.code === 'ENOENT') die(`hum state not found at ${HUM_STATE}. Is hum installed?`);
    throw e;
  }
}
function saveHumState(s) {
  const tmp = HUM_STATE + '.tmp.' + process.pid;
  fs.writeFileSync(tmp, JSON.stringify(s, null, 2));
  fs.renameSync(tmp, HUM_STATE);
}
function parseHumDuration(s) {
  if (!s) return null;
  const now = Date.now();
  const lc = s.toLowerCase().trim();
  if (lc === 'today' || lc === 'end-of-day') {
    const d = new Date(); d.setHours(23, 59, 59, 999);
    return d.toISOString();
  }
  if (lc === 'until-morning' || lc === 'morning') {
    const d = new Date();
    if (d.getHours() >= 9) d.setDate(d.getDate() + 1);
    d.setHours(9, 0, 0, 0);
    return d.toISOString();
  }
  if (lc === 'weekend' || lc === 'until-monday') {
    const d = new Date();
    const day = d.getDay();
    const daysToMonday = day === 1 ? 7 : (8 - day) % 7 || 7;
    d.setDate(d.getDate() + daysToMonday);
    d.setHours(9, 0, 0, 0);
    return d.toISOString();
  }
  const m = lc.match(/^(\d+)\s*(m|min|h|hr|d|day|days)$/);
  if (m) {
    const n = parseInt(m[1], 10);
    const unit = m[2];
    const ms = unit.startsWith('m') && !unit.startsWith('min') ? n * 60 * 1000
             : unit.startsWith('min') ? n * 60 * 1000
             : unit.startsWith('h') ? n * 60 * 60 * 1000
             : n * 24 * 60 * 60 * 1000;
    return new Date(now + ms).toISOString();
  }
  const iso = new Date(s);
  if (!isNaN(iso.getTime())) return iso.toISOString();
  return null;
}
function formatHumTime(iso) {
  if (!iso) return c.dim('—');
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  const mins = Math.round((Date.now() - d.getTime()) / 60000);
  if (mins < 1) return `${d.toLocaleString()} ${c.dim('(just now)')}`;
  if (mins < 60) return `${d.toLocaleString()} ${c.dim(`(${mins}m ago)`)}`;
  const hrs = Math.round(mins / 60);
  if (hrs < 48) return `${d.toLocaleString()} ${c.dim(`(${hrs}h ago)`)}`;
  return `${d.toLocaleString()} ${c.dim(`(${Math.round(hrs/24)}d ago)`)}`;
}

function cmdHum(args) {
  const sub = args[0];
  if (!sub || sub === 'help' || sub === '--help') return cmdHumHelp();
  const subs = {
    status: cmdHumStatus,
    pause: cmdHumPause,
    resume: cmdHumResume,
    feedback: cmdHumFeedback,
    runs: cmdHumRuns,
    review: cmdHumReview,
    test: cmdHumTest,
    tune: cmdHumTune,
    question: cmdHumQuestion,
    learn: cmdHumLearn,
    learnings: cmdHumLearnings,
    situation: cmdHumSituation,
    sense: cmdHumSense,
    insight: cmdHumInsight,
    audit: cmdHumAudit,
    reactions: cmdHumReactions,
    signal: cmdHumSignal,
    intervention: cmdHumIntervention,
    lane: cmdHumLane,
  };
  const fn = subs[sub];
  if (!fn) die(`unknown: hum ${sub}. Try: edva hum help`);
  fn(args.slice(1));
}

