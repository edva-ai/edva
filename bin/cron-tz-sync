#!/usr/bin/env node
"use strict";
/**
 * cron-tz-sync — rewrite the crontab clock times (the crontab runs in the
 * instance's home zone, lib/instance.cjs tz) of the user's "local
 * morning / local evening" cron jobs (morning-digest, daily-summary, etc.) so
 * they fire at the intended LOCAL hour wherever the user actually is, instead
 * of a fixed home-zone clock time.
 *
 * Runs once nightly (00:05 local, well before any job's earliest possible
 * adjusted fire time) rather than polling — a precomputed schedule adjustment
 * is cheaper and more predictable than a live 15-min check loop.
 *
 * Timezone resolution, in priority order:
 *   1. data/user-timezone.json, if updated within the last 36h — the
 *      phone's own self-reported IANA timezone, refreshed on every inbound
 *      Edva message. This is the "confirm via actual location" signal.
 *   2. the installation's travel plan (its `travel where` mapped through its
 *      metro → zone table), when it has one —
 *      the forward-looking travel-plan signal, used when the phone hasn't
 *      reported recently (e.g. mid-flight, or syncing tomorrow's schedule
 *      the night before the user lands somewhere new).
 *   3. the instance's home zone.
 * When both 1 and 2 resolve and disagree, (1) wins and the disagreement is
 * logged — the live-confirmed location overrides the plan.
 *
 * The rewrite is POSITIONAL (tokens 0/1/4 of the line), so it is only valid
 * on a line that really is an active 5-field crontab entry. Two guards keep
 * it that way, both added 2026-09-05 after it corrupted trigger-hum-daily:
 * a disabled line (`#HUMPAUSE# 0 23 * * * …`) was matched by its --label,
 * and the rewrite overwrote the comment marker with the minute and shifted
 * every remaining field one place right, yielding `0 23 23 * * * …` — six
 * fields, an unrunnable command, and the pause marker silently deleted, so
 * the job would not have come back when the pause was lifted.
 */

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync } = require("child_process");
const { loadClockJobs, resolveTz, localToHomeZone, homeZoneLabel } = require("../lib/clock-jobs.js");
const { installRoot } = require("../lib/root.cjs");

const HOME = os.homedir();
const EDVA = installRoot();
const LOG_FILE = path.join(EDVA, "data/logs/cron-tz-sync.log");

// lang-regex-ok: matches a crontab SCHEDULE FIELD, which is machine-generated
// structure (digits, * , - / and the JAN/MON name forms), never natural language.
const CRON_FIELD = /^[A-Za-z0-9*,/-]+$/;

function log(line) {
  const ts = new Date().toISOString();
  try { fs.mkdirSync(path.dirname(LOG_FILE), { recursive: true }); } catch {}
  fs.appendFileSync(LOG_FILE, `${ts} ${line}\n`);
}

/** True when `line` is an active crontab entry whose first five tokens are a
 *  schedule and whose sixth token begins the command. A disabled/commented
 *  line is never active, whatever it contains. */
function isActiveCronEntry(line) {
  const trimmed = line.trimStart();
  if (!trimmed || trimmed.startsWith("#")) return false;
  const tokens = trimmed.split(/\s+/);
  if (tokens.length < 6) return false;
  return tokens.slice(0, 5).every(t => CRON_FIELD.test(t));
}

/**
 * Pure line rewriter — separated from crontab I/O so the guards above are
 * testable against real crontab text.
 * Returns { next, changes, skipped }.
 */
function rewriteLines(lines, jobs, tz) {
  const changes = [];
  const skipped = [];
  const next = lines.map(line => {
    for (const job of jobs) {
      const marker = `--label ${job.label} `;
      if (!line.includes(marker)) continue;
      if (!isActiveCronEntry(line)) { skipped.push(job.name); return line; }
      const tokens = line.trim().split(/\s+/);
      const { hour, minute, dow } = localToHomeZone(tz, job.local_time, job.dow);
      const oldSpec = tokens.slice(0, 5).join(" ");
      tokens[0] = String(Number(minute));
      tokens[1] = String(Number(hour));
      tokens[4] = job.dow != null ? String(dow) : "*";
      const newLine = tokens.join(" ");
      // Refuse to emit anything that is not still a well-formed entry. A
      // positional rewrite that cannot be proven safe is a no-op, not a guess.
      if (!isActiveCronEntry(newLine)) { skipped.push(`${job.name} (rewrite would malform)`); return line; }
      const newSpec = tokens.slice(0, 5).join(" ");
      if (newSpec !== oldSpec) changes.push(`${job.name}: ${oldSpec} -> ${newSpec} ${homeZoneLabel()} (local ${job.local_time} in ${tz})`);
      return newLine;
    }
    return line;
  });
  return { next, changes, skipped };
}

function rewriteCrontab(jobs, tz) {
  const current = execFileSync("crontab", ["-l"], { encoding: "utf8" });
  const { next, changes, skipped } = rewriteLines(current.split("\n"), jobs, tz);
  if (changes.length) {
    execFileSync("crontab", ["-"], { input: next.join("\n") + "\n" });
  }
  return { changes, skipped };
}

function main() {
  const jobs = loadClockJobs();
  const { tz, source } = resolveTz((confirmed, planned) => {
    log(`discrepancy: confirmed=${confirmed} planned=${planned} — using confirmed`);
  });
  const { changes, skipped } = rewriteCrontab(jobs, tz);
  if (changes.length) {
    log(`resolved tz=${tz} (${source}); updated ${changes.length} job(s): ${changes.join("; ")}`);
  } else {
    log(`resolved tz=${tz} (${source}); no changes needed`);
  }
  // A tz-managed job sitting disabled is worth saying out loud once a night —
  // otherwise "no changes needed" reads as "everything is scheduled correctly".
  if (skipped.length) log(`skipped ${skipped.length} disabled/unparseable line(s): ${skipped.join(", ")}`);
  console.log(JSON.stringify({ tz, source, changes, skipped }, null, 2));
}

if (require.main === module) main();

module.exports = { rewriteLines, isActiveCronEntry };
