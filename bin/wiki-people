#!/usr/bin/env node
// wiki-people — person-page graph checks and link plumbing for the weekly
// wiki-link-weave job (jobs/wiki-link-weave.md).
//
// Person pages carry `entity: person` in frontmatter; hubs (family,
// colleagues, …) carry `entity: people-hub`. Everything here is mechanical:
// the job's model decides who a mention means, this tool records and
// rewrites links.

"use strict";

const people = require("../lib/wiki-people.js");
const linker = require("../lib/wiki-linker.js");
const ws = require("../lib/wiki-store.js");

const args = process.argv.slice(2);
const cmd = args[0];

function flag(name, def = undefined) {
  const i = args.indexOf(`--${name}`);
  if (i === -1) return def;
  const next = args[i + 1];
  if (!next || next.startsWith("--")) return true;
  return next;
}

function multi(name) {
  const out = [];
  args.forEach((a, i) => {
    if (a === `--${name}` && args[i + 1] && !args[i + 1].startsWith("--")) out.push(args[i + 1]);
  });
  return out;
}

function usage() {
  console.log(`wiki-people — person pages, relations and concept aliases

Usage:
  wiki-people audit [--json]
      person pages, hubs, one-way person links, people missing from the
      concept map, alias collisions, pages nothing links to
  wiki-people concept-add --target ID [--alias "Full Name"]... [--ambiguous "Guy"]...
      upsert a concept-map entry; --ambiguous names are never auto-linked
  wiki-people retarget --from ID --to ID --display "Text" [--dry-run] [--json]
      rewrite [[from|Text]] links to [[to|Text]] across the wiki

Concept map: ${linker.DEFAULT_CONCEPTS_PATH}
`);
}

const asJson = Boolean(flag("json", false));
const conceptsPath = typeof flag("concepts") === "string" ? flag("concepts") : linker.DEFAULT_CONCEPTS_PATH;

try {
  if (!cmd || cmd === "-h" || cmd === "--help") {
    usage();
  } else if (cmd === "audit") {
    const r = people.audit({ conceptsPath });
    if (asJson) {
      console.log(JSON.stringify(r, null, 2));
    } else {
      console.log(`${r.people.length} person page(s), ${r.hubs.length} hub(s)`);
      const section = (title, rows) => {
        if (!rows.length) return;
        console.log(`\n${title} (${rows.length})`);
        for (const row of rows) console.log(`  ${row}`);
      };
      section("one-way person links — add the return link", r.asymmetric.map((a) => a.need));
      section("person pages missing from the concept map", r.not_in_concepts);
      section("person pages with only ambiguous aliases", r.no_safe_alias);
      section("alias collisions (model-only)", r.collisions.map((c) => `${c.alias}: ${c.targets.join(", ")}`));
      section("pages nothing links to", r.orphans);
    }
  } else if (cmd === "concept-add") {
    const r = people.addConcept({
      target: flag("target"),
      aliases: multi("alias"),
      ambiguous: multi("ambiguous"),
      conceptsPath,
    });
    console.log(asJson ? JSON.stringify(r, null, 2) : `${r.target}: ${r.changed ? "updated" : "unchanged"}`);
  } else if (cmd === "retarget") {
    const r = people.retarget({
      from: flag("from"),
      to: flag("to"),
      display: flag("display"),
      dryRun: Boolean(flag("dry-run", false)),
    });
    if (asJson) console.log(JSON.stringify({ changed: r }, null, 2));
    else {
      for (const c of r) console.log(`${c.id}: ${c.count}`);
      console.log(`${r.length} page(s)${flag("dry-run", false) ? " would change" : " updated"}`);
    }
  } else {
    usage();
    process.exitCode = 2;
  }
} catch (err) {
  console.error(`wiki-people: ${err.message}`);
  process.exitCode = 1;
} finally {
  ws.closeDb();
}
