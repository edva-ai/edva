#!/usr/bin/env node
// context-sync — Index data sources into the unified context memory.
// Usage:
//   context-sync notes    — index Apple Notes
//   context-sync imsg     — index recent iMessage conversations
//   context-sync email    — index email classification memories
//   context-sync files    — index key project files
//   context-sync all      — run all sources

import { createRequire } from "node:module";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { readFileSync, existsSync, readdirSync, statSync } from "node:fs";
import path from "node:path";

const require = createRequire(import.meta.url);
const cm = require("../lib/context-memory");
const wiki = require("../lib/wiki-store");
const { localConfig, supabaseUrl, supabaseAnonKey } = require("../lib/instance.cjs");

// This installation's sources (agent/local/config/context-sync.json):
//   key_files         [{path, tags}] under tools/, indexed by `files`
//   docs_dirs         directories under $HOME scanned by `docs`
// `watchlist` reads with the installation's Supabase anon key
// (agent/local/config/supabase.json via instance.cjs supabaseAnonKey(),
// else SUPABASE_ANON_KEY).
const CONFIG = localConfig("context-sync", {
  key_files: [{ path: "data/email-triage-playbook.md", tags: "email,triage,playbook" }],
  docs_dirs: ["Documents"],
});

const exec = promisify(execFile);
const TOOLS = path.resolve(new URL("..", import.meta.url).pathname);
const BIN = path.join(TOOLS, "bin");
const DATA = path.join(TOOLS, "data");

const cmd = process.argv[2];

async function run(command, args = []) {
  try {
    const { stdout } = await exec(command, args, { timeout: 60000 });
    return stdout.trim();
  } catch (err) {
    console.error(`  Error running ${command} ${args[0] || ""}: ${err.message}`);
    return "";
  }
}

// ── Notes ──

async function syncNotes() {
  process.stderr.write("Syncing notes... ");

  // kernel-closure-ok: an optional installation CLI; run() never throws (absent → nothing indexed)
  const raw = await run(path.join(BIN, "notes"), ["list"]);
  if (!raw) {
    console.error("no notes found or error.");
    return;
  }

  const lines = raw.split("\n").filter(Boolean);
  const allIds = [];
  let upserted = 0;

  for (const line of lines) {
    // Format: "Folder | Title" or just "Title" (when listing a specific folder)
    const pipeIdx = line.indexOf(" | ");
    const folder = pipeIdx >= 0 ? line.slice(0, pipeIdx).trim() : "";
    const title = pipeIdx >= 0 ? line.slice(pipeIdx + 3).trim() : line.trim();
    if (!title) continue;

    allIds.push(title);

    // Read note body
    // kernel-closure-ok: an optional installation CLI; run() never throws (absent → nothing indexed)
    const body = await run(path.join(BIN, "notes"), ["read", title]);
    const summary = body ? `${title}\n${body.slice(0, 200)}` : title;

    cm.upsert({
      source: "notes",
      sourceId: title,
      summary,
      tags: folder,
      metadata: { folder },
    });
    upserted++;
  }

  const stale = cm.removeStale("notes", allIds);
  console.error(`${upserted} upserted, ${stale} stale removed.`);
}

// ── iMessage ──

async function syncImsg() {
  process.stderr.write("Syncing imsg... ");

  // kernel-closure-ok: an optional installation CLI; run() never throws (absent → nothing indexed)
  const raw = await run(path.join(BIN, "imsg"), ["chats", "--limit", "30"]);
  if (!raw) {
    console.error("no chats found or error.");
    return;
  }

  const lines = raw.split("\n").filter(Boolean);
  const allIds = [];
  let upserted = 0;

  for (const line of lines) {
    // Format: "Contact Name  (N msgs, last: 2026-04-07 12:34:56)"
    const match = line.match(/^(.+?)\s{2,}\((\d+) msgs?, last: (.+?)\)$/);
    if (!match) continue;

    const contact = match[1].trim();
    const msgCount = parseInt(match[2], 10);
    const lastDate = match[3].trim();

    // Skip chats with no recent activity (> 7 days old)
    const lastMs = new Date(lastDate.replace(" ", "T")).getTime();
    const sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
    if (lastMs < sevenDaysAgo) continue;

    allIds.push(contact);

    // Read recent messages
    // kernel-closure-ok: an optional installation CLI; run() never throws (absent → nothing indexed)
    const messages = await run(path.join(BIN, "imsg"), ["read", contact, "--limit", "5", "--days", "7"]);
    const preview = messages
      ? messages
          .split("\n")
          .slice(-3)
          .map((l) => l.trim())
          .join(" | ")
          .slice(0, 200)
      : "";

    const summary = `${contact} — ${preview || "(no recent messages)"}`;

    cm.upsert({
      source: "imsg",
      sourceId: contact,
      summary,
      tags: contact,
      metadata: { lastMessage: lastDate, messageCount: msgCount },
    });
    upserted++;
  }

  const stale = cm.removeStale("imsg", allIds);
  console.error(`${upserted} upserted, ${stale} stale removed.`);
}

// ── Email Memories ──

function syncEmail() {
  process.stderr.write("Syncing email... ");

  const em = require("../lib/email-memory");
  const memories = em.list({ limit: 500 });
  const allIds = [];
  let upserted = 0;

  for (const m of memories) {
    const sourceId = `mem-${m.id}`;
    allIds.push(sourceId);

    cm.upsert({
      source: "email",
      sourceId,
      summary: m.text,
      tags: m.tags || "",
      metadata: { emailMemoryId: m.id, createdAt: m.created_at },
      expiresAt: m.expires_at || null,
    });
    upserted++;
  }

  const stale = cm.removeStale("email", allIds);
  console.error(`${upserted} upserted, ${stale} stale removed.`);
}

// ── Key Project Files ──

function syncFiles() {
  process.stderr.write("Syncing files... ");

  const KEY_FILES = CONFIG.key_files;

  const allIds = [];
  let upserted = 0;

  for (const f of KEY_FILES) {
    const fullPath = path.join(DATA, "..", f.path);
    if (!existsSync(fullPath)) continue;

    allIds.push(f.path);

    const content = readFileSync(fullPath, "utf8");
    const filename = path.basename(f.path);
    const summary = `${filename}\n${content.slice(0, 300)}`;

    cm.upsert({
      source: "files",
      sourceId: f.path,
      summary,
      tags: f.tags,
      metadata: { fullPath: fullPath },
    });
    upserted++;
  }

  const stale = cm.removeStale("files", allIds);
  console.error(`${upserted} upserted, ${stale} stale removed.`);
}

// ── Wiki Recall Cards ──

function wikiBodyPreview(page) {
  return String(page?.body_md || "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/\[[^\]]+\]\([^)]+\)/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 240);
}

function parseScopeJson(scopeJson) {
  try {
    const parsed = scopeJson ? JSON.parse(scopeJson) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function syncWiki() {
  process.stderr.write("Syncing wiki... ");

  const pages = wiki.listPages({ status: "active" });
  const allIds = [];
  let upserted = 0;
  let skipped = 0;
  const existingStmt = cm.db().prepare(
    "SELECT summary, tags, metadata_json, expires_at FROM entries WHERE source = ? AND source_id = ?",
  );

  for (const row of pages) {
    const page = wiki.getPage(row.id);
    if (!page) continue;
    allIds.push(page.id);

    const scope = parseScopeJson(page.scope_json);
    const summaryParts = [page.title, page.description, wikiBodyPreview(page)].filter(Boolean);
    const tags = [page.type, page.status, page.pinned ? "pinned" : "", ...scope]
      .filter(Boolean)
      .join(",");
    const metadata = {
      pageId: page.id,
      basename: page.basename,
      title: page.title,
      type: page.type,
      status: page.status,
      pinned: !!page.pinned,
      updatedAt: page.updated_at,
      description: page.description,
    };
    const existing = existingStmt.get("wiki", page.id);
    const metaJson = JSON.stringify(metadata);
    if (
      existing &&
      existing.summary === summaryParts.join(" — ") &&
      existing.tags === tags &&
      existing.metadata_json === metaJson &&
      (existing.expires_at || null) === null
    ) {
      skipped++;
      continue;
    }

    cm.upsert({
      source: "wiki",
      sourceId: page.id,
      summary: summaryParts.join(" — "),
      tags,
      metadata,
    });
    upserted++;
  }

  const stale = cm.removeStale("wiki", allIds);
  console.error(`${upserted} upserted, ${skipped} unchanged, ${stale} stale removed.`);
}

// ── Documents (docx, pdf, xlsx, xls from multiple directories) ──

const DOCS_DIRS = CONFIG.docs_dirs.map((d) => path.join(process.env.HOME, ...d.split("/")));
const DOC_EXTENSIONS = new Set([".pdf", ".docx", ".xlsx", ".xls"]);

function findDocs(dir, maxDepth = 3, depth = 0) {
  const results = [];
  if (depth >= maxDepth) return results;
  let entries;
  try {
    entries = readdirSync(dir, { withFileTypes: true });
  } catch {
    return results;
  }
  for (const entry of entries) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory() && !entry.name.startsWith(".")) {
      results.push(...findDocs(full, maxDepth, depth + 1));
    } else if (entry.isFile() && DOC_EXTENSIONS.has(path.extname(entry.name).toLowerCase())) {
      results.push(full);
    }
  }
  return results;
}

async function extractText(filePath) {
  const ext = path.extname(filePath).toLowerCase();
  try {
    switch (ext) {
      case ".docx": {
        const { stdout } = await exec("textutil", ["-convert", "txt", "-stdout", filePath], { timeout: 15000 });
        return stdout.trim();
      }
      case ".pdf": {
        const { stdout } = await exec("pdftotext", ["-l", "3", "-q", filePath, "-"], { timeout: 15000 });
        return stdout.trim();
      }
      case ".xlsx":
      case ".xls": {
        const XLSX = require("xlsx");
        const wb = XLSX.readFile(filePath, { sheetRows: 20 });
        const texts = [];
        for (const name of wb.SheetNames.slice(0, 3)) {
          const csv = XLSX.utils.sheet_to_csv(wb.Sheets[name]);
          if (csv.trim()) texts.push(`[${name}] ${csv}`);
        }
        return texts.join("\n").trim();
      }
      default:
        return "";
    }
  } catch (e) {
    // Surface WHY, don't just count it. This bare `catch { return "" }` made
    // every extraction failure indistinguishable from an empty file, so a
    // two-week outage (a few upserted, over a thousand failed on every 30-min
    // run, exit 0) went completely unnoticed. Two stacked causes were hiding in here:
    // a missing `pdftotext` binary, and macOS TCC denying cron read access to
    // ~/Documents. Both are one-line diagnoses once the message is visible.
    extractErrors.push({ filePath, reason: (e && e.message) || String(e) });
    erroredPaths.add(filePath);
    return "";
  }
}

// Collected per-run so syncDocs() can report a failure histogram rather than a
// bare count. `erroredPaths` lets the caller tell a genuine extraction error
// apart from a clean run that yielded no text. Both reset per syncDocs() call.
let extractErrors = [];
let erroredPaths = new Set();

async function syncDocs() {
  process.stderr.write("Syncing docs... ");
  extractErrors = [];
  erroredPaths = new Set();

  // Collect files from all configured directories
  const filesByBase = new Map(); // relPath -> { filePath, baseDir }
  for (const dir of DOCS_DIRS) {
    if (!existsSync(dir)) continue;
    for (const filePath of findDocs(dir)) {
      const relPath = path.relative(dir, filePath);
      const baseName = path.basename(dir);
      const key = `${baseName}/${relPath}`;
      filesByBase.set(key, { filePath, baseDir: dir, baseName });
    }
  }

  if (filesByBase.size === 0) {
    console.error("no documents found.");
    return;
  }

  const allIds = [];
  let upserted = 0;
  let errors = 0;
  let empty = 0;   // extractor ran clean but the file has no extractable text
  const entries = [...filesByBase.entries()];

  // Process in batches of 10 for concurrency
  for (let i = 0; i < entries.length; i += 10) {
    const batch = entries.slice(i, i + 10);
    const results = await Promise.all(
      batch.map(async ([key, { filePath, baseDir, baseName }]) => {
        const relPath = path.relative(baseDir, filePath);
        const filename = path.basename(filePath);
        const ext = path.extname(filePath).toLowerCase().slice(1);
        const folder = path.dirname(relPath);

        allIds.push(key);

        const text = await extractText(filePath);
        if (!text) {
          // "No text" has two very different causes and they were being counted
          // as one. An EXCEPTION (missing binary, unreadable file, timeout) is a
          // real failure. An extractor that ran cleanly and simply found nothing
          // — an image-only scanned PDF with no text layer, an empty sheet — is
          // a normal, permanent property of that file, not something to fix.
          // Conflating them is what produced an alarming "N failed" count; once
          // the real cause is fixed the true error count is single digits.
          if (erroredPaths.has(filePath)) errors++;
          else empty++;
          return;
        }

        const summary = `${filename}\n${text.slice(0, 200)}`;
        const tags = [ext, baseName, folder !== "." ? folder : ""].filter(Boolean).join(",");

        cm.upsert({
          source: "docs",
          sourceId: key,
          summary,
          tags,
          metadata: { fullPath: filePath, ext, folder: folder !== "." ? folder : "", baseDir: baseName },
        });
        upserted++;
      })
    );
  }

  const stale = cm.removeStale("docs", allIds);
  console.error(`${upserted} upserted, ${errors} failed, ${empty} no-text, ${stale} stale removed.`);

  // A doc corpus that is mostly unreadable is a broken sync, not a quiet one.
  // Report the top failure reasons and exit non-zero past a 50% failure rate so
  // cron surfaces it — the same hardening a backfill job took on 2026-07-17
  // after failing while exiting 0 for weeks.
  if (extractErrors.length) {
    // Bucket by failure CLASS, not by raw message. The raw text embeds the
    // file path ("Command failed: pdftotext -l 3 -q /Users/.../foo.pdf -"), so
    // keying on it gives one bucket per file — a histogram where every bar is
    // 1, which tells you nothing about what's actually wrong. Strip the
    // arguments down to the failing command (plus the extension, since
    // "pdftotext on .pdf" and a docx failure are different problems).
    const classify = (reason, filePath) => {
      const head = reason.split("\n")[0];
      const ext = (filePath.match(/\.[A-Za-z0-9]+$/) || [""])[0].toLowerCase();
      const cmd = head.match(/Command failed: (\S+)/);
      if (cmd) return `${cmd[1]} failed on ${ext || "(no ext)"}`;
      if (/EACCES|operation not permitted/i.test(head)) return `permission denied on ${ext}`;
      if (/ENOENT/.test(head)) return `file missing on ${ext}`;
      if (/timed? ?out/i.test(head)) return `timeout on ${ext}`;
      return `${head.slice(0, 60)} (${ext})`;
    };
    const byReason = new Map();
    const example = new Map();
    for (const { reason, filePath } of extractErrors) {
      const key = classify(reason, filePath);
      byReason.set(key, (byReason.get(key) || 0) + 1);
      if (!example.has(key)) example.set(key, filePath);
    }
    const top = [...byReason.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
    console.error(`  extraction failures by class (${extractErrors.length} total):`);
    for (const [reason, n] of top) {
      console.error(`    ${String(n).padStart(5)}  ${reason}  e.g. ${path.basename(example.get(reason))}`);
    }
    const total = upserted + errors;
    if (total > 0 && errors / total > 0.5) {
      console.error(
        `  ${errors}/${total} docs unreadable (>50%) — treating as a failed sync. ` +
        `Common causes: missing extractor binary (brew install poppler for pdftotext), ` +
        `or macOS TCC denying cron read access to a protected folder (grant Full Disk Access to /usr/sbin/cron).`,
      );
      process.exitCode = 1;
    }
  }
}

// ── Watchlist (Supabase) ──

async function syncWatchlist() {
  process.stderr.write("Syncing watchlist... ");

  let createClient;
  try {
    createClient = (await import("@supabase/supabase-js")).createClient;
  } catch {
    console.error("skipped (@supabase/supabase-js not available).");
    return;
  }

  const anonKey = supabaseAnonKey() || process.env.SUPABASE_ANON_KEY;
  if (!supabaseUrl() || !anonKey) {
    console.error("skipped (no Supabase project or anon key configured).");
    return;
  }
  const supabase = createClient(supabaseUrl(), anonKey);

  const { data, error } = await supabase.from("watchlist").select("*");
  if (error) {
    console.error(`error: ${error.message}`);
    return;
  }

  const allIds = [];
  let upserted = 0;

  for (const e of data) {
    const sourceId = e.title;
    allIds.push(sourceId);

    const status = e.watched ? "watched" : "to watch";
    const rating = e.rating ? ` (${e.rating})` : "";
    const platform = e.platform ? ` on ${e.platform}` : "";
    const year = e.year_start ? ` [${e.year_start}${e.year_end ? "-" + e.year_end : ""}]` : "";
    const desc = e.description ? `\n${e.description}` : "";
    const summary = `${e.title}${rating}${year}${platform} — ${e.type}, ${e.category.replace("_", " ")}, ${status}${desc}`;

    const tags = [e.type, e.category, e.platform, e.genre, status, e.notify_new_season ? "tracking-seasons" : ""]
      .filter(Boolean)
      .join(",");

    cm.upsert({
      source: "watchlist",
      sourceId,
      summary,
      tags,
      metadata: { id: e.id, category: e.category, watched: e.watched, notify: e.notify_new_season },
    });
    upserted++;
  }

  const stale = cm.removeStale("watchlist", allIds);
  console.error(`${upserted} upserted, ${stale} stale removed.`);
}

// ── Google Drive ──

const DRIVE_API = "https://www.googleapis.com/drive/v3";
const DRIVE_EXPORT_TYPES = {
  "application/vnd.google-apps.document": "text/plain",
  "application/vnd.google-apps.spreadsheet": "text/csv",
  "application/vnd.google-apps.presentation": "text/plain",
};
// Skip these Google-internal types (not user content)
const DRIVE_SKIP_TYPES = new Set([
  "application/vnd.google-apps.form",
  "application/vnd.google-apps.map",
  "application/vnd.google-apps.site",
  "application/vnd.google-apps.shortcut",
  "application/vnd.google-apps.folder",
]);
// ALLOW-LIST for the Drive listing. The context index is a TEXT search index,
// so it should only pull document-shaped files. Listing everything an account
// owns can mean millions of rows — photos, octet-streams, TIFF/RAW/HEIF, video,
// python bytecode, i.e. a Google Photos/Takeout/backup dump — none of it useful
// to search and all of it re-listed every 30 min (tens of thousands of Drive
// API calls a day; the sync never finished inside the cron timeout).
// Owner-scoping is NOT the fix (nearly all of such files are owned); the fix is
// to list only real documents. Content-extractable Google Workspace types
// (see DRIVE_EXPORT_TYPES) plus common doc formats — keeps useful SHARED docs
// too, which an owner filter would have dropped. Everything else never gets
// listed, so it never gets stored or re-exported.
const DRIVE_INDEX_TYPES = [
  "application/vnd.google-apps.document",
  "application/vnd.google-apps.spreadsheet",
  "application/vnd.google-apps.presentation",
  "application/pdf",
  "text/plain",
  "text/markdown",
  "application/rtf",
  "application/msword",
  "application/vnd.ms-excel",
  "application/vnd.ms-powerpoint",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
];

async function driveRequest(endpoint, token) {
  return driveRequestImpl(endpoint, token, true);
}

async function driveRequestImpl(endpoint, token, canRetryOn401) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 30_000);
  let res;
  try {
    res = await fetch(`${DRIVE_API}${endpoint}`, {
      headers: { Authorization: `Bearer ${token}` },
      signal: ctrl.signal,
    });
  } finally {
    clearTimeout(timer);
  }
  if (res.status === 401 && canRetryOn401) {
    const auth = require("../lib/google-auth.js");
    auth.clearCache();
    const fresh = await auth.getAccessToken();
    return driveRequestImpl(endpoint, fresh, false);
  }
  if (!res.ok) {
    const text = await res.text().catch(() => "");
    throw new Error(`Drive API ${res.status}: ${text.slice(0, 200)}`);
  }
  return res;
}

async function listAllDriveFiles(token) {
  const files = [];
  let pageToken = null;
  const fields = "nextPageToken,files(id,name,mimeType,modifiedTime,parents,webViewLink,owners,shared)";
  // Only list document-shaped files (see DRIVE_INDEX_TYPES) — this is what
  // collapses a re-list-every-30-min runaway over millions of files to the
  // real docs. The type filter runs server-side, so photos / binaries are
  // never paged back at all.
  const typeClause = DRIVE_INDEX_TYPES.map((t) => `mimeType='${t}'`).join(" or ");
  const q = `trashed=false and (${typeClause})`;

  do {
    const params = new URLSearchParams({ q, fields, pageSize: "1000", orderBy: "modifiedTime desc" });
    if (pageToken) params.set("pageToken", pageToken);
    const res = await driveRequest(`/files?${params}`, token);
    const data = await res.json();
    files.push(...(data.files || []));
    pageToken = data.nextPageToken;
  } while (pageToken);

  return files;
}

async function exportDriveFile(file, token) {
  const exportMime = DRIVE_EXPORT_TYPES[file.mimeType];
  if (exportMime) {
    // Google Workspace file — export as text
    const res = await driveRequest(`/files/${file.id}/export?mimeType=${encodeURIComponent(exportMime)}`, token);
    const text = await res.text();
    return text.slice(0, 500);
  }
  // Binary file (PDF, image, etc.) — skip content extraction, index metadata only
  return "";
}

async function buildFolderMap(token) {
  // Fetch all folders to build id→name map for path resolution
  const folders = new Map();
  let pageToken = null;
  do {
    const params = new URLSearchParams({
      q: "mimeType='application/vnd.google-apps.folder' and trashed=false",
      fields: "nextPageToken,files(id,name,parents)",
      pageSize: "1000",
    });
    if (pageToken) params.set("pageToken", pageToken);
    const res = await driveRequest(`/files?${params}`, token);
    const data = await res.json();
    for (const f of data.files || []) folders.set(f.id, { name: f.name, parent: f.parents?.[0] });
    pageToken = data.nextPageToken;
  } while (pageToken);
  return folders;
}

function resolvePath(file, folderMap) {
  const parts = [];
  let parentId = file.parents?.[0];
  while (parentId && folderMap.has(parentId)) {
    const folder = folderMap.get(parentId);
    parts.unshift(folder.name);
    parentId = folder.parent;
  }
  return parts.length ? parts.join("/") : "";
}

async function syncGoogleDrive() {
  process.stderr.write("Syncing gdrive... ");

  let getAccessToken;
  try {
    getAccessToken = require("../lib/google-auth.js").getAccessToken;
  } catch (err) {
    console.error(`skipped (google-auth not available: ${err.message})`);
    return;
  }

  let token;
  try {
    token = await getAccessToken();
  } catch (err) {
    console.error(`skipped (auth failed: ${err.message})`);
    return;
  }

  let files, folderMap;
  try {
    [files, folderMap] = await Promise.all([listAllDriveFiles(token), buildFolderMap(token)]);
  } catch (err) {
    console.error(`error listing files: ${err.message}`);
    return;
  }

  const allIds = [];
  let upserted = 0;
  let skipped = 0;
  let unchanged = 0;

  const exportable = files.filter((f) => !DRIVE_SKIP_TYPES.has(f.mimeType));

  // Change-detection: only export files whose modifiedTime differs from what we
  // already stored. Re-exporting EVERY Drive file on every 30-min run means
  // millions of Drive API export calls a month (Drive API is free, but the
  // volume risks quota and is pure waste). Unchanged files keep their existing
  // record (pushed to allIds so removeStale doesn't drop them); only
  // new/modified files are re-exported.
  const priorMetaStmt = cm.db().prepare(
    "SELECT metadata_json FROM entries WHERE source = 'gdrive' AND source_id = ?",
  );
  const priorModifiedTime = (id) => {
    const row = priorMetaStmt.get(id);
    if (!row) return null;
    try {
      return JSON.parse(row.metadata_json || "{}").modifiedTime || null;
    } catch {
      return null;
    }
  };

  const changed = [];
  for (const f of exportable) {
    if (f.modifiedTime && priorModifiedTime(f.id) === f.modifiedTime) {
      allIds.push(f.id); // unchanged — keep the record, skip the export call
      unchanged++;
    } else {
      changed.push(f);
    }
  }

  // Export text in parallel batches, then upsert sequentially (SQLite is single-writer)
  for (let i = 0; i < changed.length; i += 10) {
    const batch = changed.slice(i, i + 10);
    // Parallel: fetch text from Drive API
    const results = await Promise.all(
      batch.map(async (file) => {
        let text = "";
        try {
          text = await exportDriveFile(file, token);
        } catch {
          skipped++;
        }
        return { file, text };
      })
    );
    // Sequential: write to SQLite
    for (const { file, text } of results) {
      allIds.push(file.id);
      const folderPath = resolvePath(file, folderMap);
      const typeLabel = file.mimeType.includes("document")
        ? "doc"
        : file.mimeType.includes("spreadsheet")
          ? "sheet"
          : file.mimeType.includes("presentation")
            ? "slides"
            : path.extname(file.name).replace(".", "") || "file";

      const summary = text ? `${file.name}\n${text.slice(0, 300)}` : file.name;
      const tags = [typeLabel, folderPath, file.shared ? "shared" : ""].filter(Boolean).join(",");

      cm.upsert({
        source: "gdrive",
        sourceId: file.id,
        summary,
        tags,
        metadata: {
          name: file.name,
          mimeType: file.mimeType,
          folder: folderPath,
          modifiedTime: file.modifiedTime,
          webViewLink: file.webViewLink || null,
          shared: file.shared || false,
        },
      });
      upserted++;
    }
  }

  const stale = cm.removeStale("gdrive", allIds);
  console.error(`${upserted} upserted, ${unchanged} unchanged (export skipped), ${skipped} export failures, ${stale} stale removed.`);
}

// ── Main ──

// ── Installation sources (_ext) ──
//
// An installation adds its own source (a personal database, a project tracker)
// by dropping an ES module into lib/_ext/context-sources/:
//
//   export default {
//     name: "my-source",
//     describe: "Index my source",
//     async sync({ cm, wiki, run, BIN, DATA }) { ... cm.upsert(...); cm.removeStale(...) },
//   };
//
// `context-sync <name>` runs one; `all` runs them after the kernel sources.
// Kernel names win on a conflict; a module that fails to load or to sync is
// reported and skipped, never fatal to the other sources.
const KERNEL_SOURCES = new Set(["notes", "imsg", "email", "files", "wiki", "docs", "watchlist", "gdrive", "all"]);
async function extSources() {
  const dir = path.join(TOOLS, "lib", "_ext", "context-sources");
  if (!existsSync(dir)) return [];
  const out = [];
  for (const file of readdirSync(dir).filter((f) => f.endsWith(".mjs")).sort()) {
    try {
      const mod = (await import(path.join(dir, file))).default;
      if (!mod || typeof mod.sync !== "function" || !mod.name) continue;
      if (KERNEL_SOURCES.has(mod.name) || out.some((s) => s.name === mod.name)) {
        console.error(`context-sync: installation source ${file} shadows "${mod.name}"; kernel wins, skipped.`);
        continue;
      }
      out.push({ name: mod.name, describe: mod.describe || "(installation source)", sync: () => mod.sync({ cm, wiki, run, BIN, DATA }) });
    } catch (e) {
      console.error(`context-sync: installation source ${file} failed to load: ${e.message}`);
    }
  }
  return out;
}

async function syncExt(sources) {
  for (const s of sources) {
    try { await s.sync(); } catch (e) { console.error(`context-sync: ${s.name} failed: ${e.message}`); }
  }
}

async function syncAll() {
  await syncNotes();
  await syncImsg();
  syncEmail();
  syncFiles();
  syncWiki();
  await syncDocs();
  await syncWatchlist();
  await syncGoogleDrive();
  await syncExt(await extSources());

  const rows = cm.stats();
  const total = rows.reduce((sum, r) => sum + r.count, 0);
  console.error(`Done. Total: ${total} entries.`);
}

function usage(ext = []) {
  console.log(`context-sync — index data sources into context memory

Commands:
  notes      Index Apple Notes (title + first 200 chars)
  imsg       Index recent iMessage conversations (last 7 days)
  email      Index email classification memories
  files      Index key project files
  wiki       Index active wiki pages as compact recall cards
  docs       Index ~/Documents (docx, pdf, xlsx, xls)
  watchlist  Index watchlist from Supabase
  gdrive     Index Google Drive (Docs, Sheets, Slides, files)
  all        Run all sources
${ext.map((s) => `  ${s.name.padEnd(10)} ${s.describe}`).join("\n")}`.trimEnd() + "\n");
}

switch (cmd) {
  case "notes":
    await syncNotes();
    break;
  case "imsg":
    await syncImsg();
    break;
  case "email":
    syncEmail();
    break;
  case "files":
    syncFiles();
    break;
  case "wiki":
    syncWiki();
    break;
  case "docs":
    await syncDocs();
    break;
  case "watchlist":
    await syncWatchlist();
    break;
  case "gdrive":
    await syncGoogleDrive();
    break;
  case "all":
    await syncAll();
    break;
  default: {
    const ext = await extSources();
    const s = ext.find((x) => x.name === cmd);
    if (s) await syncExt([s]);
    else usage(ext);
  }
}
