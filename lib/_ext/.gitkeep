# Installation hooks for lib/. Each is optional; a plain install has none and
# the kernel takes its generic path. A hook that exists and throws is a real
# failure unless the call site says it fails open.
#
# choice-handlers.mjs       lib/choice-reply.mjs — tap handlers for your own
#   choice-card and checklist kinds:
#   export default { choices: { <kind>: fn }, checklists: { <kind>: fn } }
#   (kernel kinds win on a name; EDVA_CHOICE_HANDLERS overrides the path)
#
# watches.mjs               bin/hum-sense — a watch engine offered every fresh
#   event: export function spoolEvents(events)
#
# context-sources/*.mjs     bin/context-sync — extra sources:
#   export default { name, describe, async sync({ cm, wiki, run, BIN, DATA }) }
#   (`context-sync <name>` runs one; `all` runs them after the kernel's)
#
# edva-context.cjs        lib/edva-context.js — extra context sources:
#   module.exports = ({ MEMORY_DIR, DATA, TOOLS, defaults, shSafe, readJsonSafe })
#     => ({ knowledge?, tasteFiles?, profileFiles?, projectFiles?, counts? })
#   (EDVA_CONTEXT_OVERLAY overrides the path)
#
# presence.mjs              lib/claim-facts.mjs, hum-idea-locality.mjs,
#   bin/hum-ideas-append — where the user is on a date:
#   export function provider() → { fetchSegments, loadFlights, slugify,
#     normalizeMetro, parseWhen, resolvePresenceAt, METRO_DEFS, AMBIGUOUS_SEP }
#   (without it every presence check fails open)
#
# claim-freshness-timeline.mjs   lib/claim-freshness.mjs — the travel timeline
#   CLI: export function travelBin() → path of a CLI printing `list --json`
#
# self-improve-landing.mjs  lib/self-improve-landing.mjs — extra refusals for
#   a self-improvement change:
#   export function landingRefusals({ files, before }) → string[]
#
# Everything here except this file is gitignored — see .gitignore and
# docs/architecture-public-private.md.
