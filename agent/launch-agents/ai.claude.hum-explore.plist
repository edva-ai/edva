<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hum-explore — ON-DEMAND launchd user agent (no schedule of its own).
  Playbook: agent/ops-agent/jobs/hum-explore.md

  Cron keeps the schedule (12:30 and 17:30 local, clock-jobs.json):
  agent/scripts/trigger-hum-explore.sh only runs
  `launchctl kickstart gui/$(id -u)/ai.claude.hum-explore`. The run
  (run-hum-explore.sh) sends its pick through edva-send-curl, whose
  resolve-first gate and outbound precheck are `claude -p` on the Max
  subscription, and only the GUI session can unlock the keychain holding that
  credential. From cron both gates fail open and the pick would go out
  unchecked.

  Install:
    agent/launch-agents/install.sh ai.claude.hum-explore
    (renders __EDVA_HOME__ / __EDVA_TOOLS__ / __HOME__, then launchctl bootstrap)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.claude.hum-explore</string>
    <key>ProgramArguments</key>
    <array>
        <string>__EDVA_TOOLS__/bin/cron-run</string>
        <string>--label</string>
        <string>hum-explore</string>
        <string>--</string>
        <string>/bin/bash</string>
        <string>__EDVA_TOOLS__/agent/scripts/run-hum-explore.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:__HOME__/.local/node/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__EDVA_TOOLS__/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__EDVA_HOME__</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__EDVA_TOOLS__/data/logs/hum-explore-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__EDVA_TOOLS__/data/logs/hum-explore-launchd.log</string>
</dict>
</plist>
